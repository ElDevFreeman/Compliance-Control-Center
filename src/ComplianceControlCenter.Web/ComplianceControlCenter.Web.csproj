<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>85fd7f56-0236-4afe-a45c-9bee098cb7b4</UserSecretsId>
    <RootNamespace>ComplianceControlCenter.Web</RootNamespace>

    <!-- Comandos y rutas del pipeline de Tailwind. -->
    <TailwindInput>Styles/app.css</TailwindInput>
    <TailwindOutput>wwwroot/css/site.css</TailwindOutput>
    <TailwindCli>node_modules/.bin/tailwindcss</TailwindCli>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Blazor-ApexCharts" Version="6.1.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.30" />
  </ItemGroup>

  <!--
       Tailwind CSS pipeline.

       Antes de cada 'dotnet build' se regenera wwwroot/css/site.css a
       partir de Styles/app.css y las clases usadas en los .razor.

       * Si falta node_modules, ejecuta 'pnpm install' primero.
       * Se pasa el flag de minificacion solo en Release.
       * Vigila los .razor y Styles/app.css: si nada cambio, MSBuild
         omite el target (incremental build).
  -->

  <ItemGroup>
    <TailwindWatchInputs Include="Styles/**/*.css" />
    <TailwindWatchInputs Include="Components/**/*.razor" />
    <TailwindWatchInputs Include="Modules/**/*.razor" />
    <TailwindWatchInputs Include="Shared/**/*.razor" />
    <TailwindWatchInputs Include="tailwind.extension.json" Condition="Exists('tailwind.extension.json')" />
  </ItemGroup>

  <ItemGroup>
    <!-- El catálogo CTPAT (139 preguntas + guidance) se carga en runtime por CtpatSeeder. -->
    <None Include="Modules\Ctpat\Data\ctpat_data.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!--
       Asegurar que exista la carpeta 'logs' en el output del publish.
       ANCM (AspNetCoreModuleV2) la necesita cuando stdoutLogEnabled=true.
       Si no existe y el AppPool identity no puede crearla, ANCM falla
       silenciosamente al escribir logs.
  -->
  <Target Name="EnsureLogsFolder" AfterTargets="Publish">
    <MakeDir Directories="$(PublishDir)logs" />
    <WriteLinesToFile File="$(PublishDir)logs\.gitkeep" Lines="" Overwrite="true" />
  </Target>

  <Target Name="EnsureNodeModules" BeforeTargets="BuildTailwind" Condition="!Exists('node_modules/.bin/tailwindcss') And !Exists('node_modules\.bin\tailwindcss.cmd')">
    <Message Importance="high" Text="→ Instalando dependencias de npm (pnpm install)…" />
    <Exec Command="pnpm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="BuildTailwind" BeforeTargets="BeforeBuild" Inputs="@(TailwindWatchInputs)" Outputs="$(TailwindOutput)">
    <Message Importance="high" Text="→ Generando $(TailwindOutput) con Tailwind CSS ($(Configuration))…" />

    <!-- Windows: usa el .cmd; otros SO: usa el script sin extensión. -->
    <Exec Command="&quot;$(TailwindCli).cmd&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' == 'Release'" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="&quot;$(TailwindCli).cmd&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot;" Condition="'$(OS)' == 'Windows_NT' And '$(Configuration)' != 'Release'" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="&quot;$(TailwindCli)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot; --minify" Condition="'$(OS)' != 'Windows_NT' And '$(Configuration)' == 'Release'" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Exec Command="&quot;$(TailwindCli)&quot; -i &quot;$(TailwindInput)&quot; -o &quot;$(TailwindOutput)&quot;" Condition="'$(OS)' != 'Windows_NT' And '$(Configuration)' != 'Release'" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="CleanTailwind" AfterTargets="Clean">
    <Delete Files="$(TailwindOutput)" Condition="Exists('$(TailwindOutput)')" />
  </Target>

</Project>
