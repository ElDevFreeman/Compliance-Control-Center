@inject ComplianceControlCenter.Web.Core.State.ThemeState Theme
@inject IHttpContextAccessor Http
<!DOCTYPE html>
<html lang="es-MX" data-theme="@Theme.Current">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@BaseHref" />
    <link rel="stylesheet" href="css/site.css" />
    @* No se referencia "ComplianceControlCenter.Web.styles.css" porque el
       proyecto no tiene ningún archivo *.razor.css (scoped CSS), y por lo
       tanto ASP.NET Core no genera ese bundle → daría 404 en la consola. *@
    <link rel="icon" type="image/png" href="img/lobo.png?v=1" />
    @* Atribución del icono del lobo (requerida por licencia Flaticon) *@
    <!-- Lobo iconos creados por AbtoCreative - Flaticon: https://www.flaticon.es/iconos-gratis/lobo -->
    <meta name="icon-attribution" content="Lobo iconos creados por AbtoCreative - Flaticon (https://www.flaticon.es/iconos-gratis/lobo)" />
    <link rel="author" href="https://www.flaticon.es/iconos-gratis/lobo" title="Lobo iconos creados por AbtoCreative - Flaticon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
    <title>Compliance Control Center</title>
    <HeadOutlet />
    <script>
        // Aplica el tema desde la cookie/localStorage antes de que Blazor pinte,
        // para evitar cualquier flash de tema incorrecto.
        (function () {
            try {
                var m = document.cookie.match(/(?:^|;\s*)ccc_theme=([^;]+)/);
                var t = m ? decodeURIComponent(m[1]) : (localStorage.getItem("ccc_theme") || "emerald");
                if (t !== "emerald" && t !== "dark") t = "emerald";
                document.documentElement.setAttribute("data-theme", t);
            } catch (e) { }
        })();
    </script>
</head>

<body class="min-h-screen bg-base-200 text-base-content">
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/app.js"></script>
</body>

</html>

@code {
    // Respeta el PathBase configurado (p. ej. "/CCC") para que todos los
    // recursos relativos (css, js, _framework, hubs) resuelvan bajo la subruta.
    private string BaseHref
    {
        get
        {
            var pb = Http.HttpContext?.Request.PathBase.Value;
            if (string.IsNullOrEmpty(pb)) return "/";
            return pb.EndsWith("/") ? pb : pb + "/";
        }
    }
}
