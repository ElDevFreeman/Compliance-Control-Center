@page "/"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@using ComplianceControlCenter.Web.Core.State
@using ComplianceControlCenter.Web.Modules.Oea.Domain.Enums
@using ComplianceControlCenter.Web.Modules.Ctpat.Domain.Enums
@using ComplianceControlCenter.Web.Modules.Ctpat.Services
@using ComplianceControlCenter.Web.Core.Data
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject UserSessionState UserSession
@inject AppDbContext Db
@inject ICtpatReviewService CtpatReviewService
@inject ThemeState Theme
@implements IDisposable

<PageTitle>Compliance Control Center</PageTitle>

@* ── Modal: logo a pantalla completa ────────────────────────── *@
@if (_logoModalOpen)
{
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm"
         @onclick="CloseLogo">
        <div class="relative max-w-xl w-full mx-4" @onclick:stopPropagation>
            <div class="rounded-2xl bg-black overflow-hidden shadow-2xl ring-1 ring-white/10">
                <img src="img/TradeCompliance.png"
                     alt="Trade Compliance"
                     class="w-full h-auto" />
            </div>
            <button class="btn btn-sm btn-circle btn-ghost absolute -top-3 -right-3 bg-base-100"
                    @onclick="CloseLogo">✕</button>
        </div>
    </div>
}

<div class="flex flex-col gap-6 max-w-5xl mx-auto w-full">

    @* ── Hero ─────────────────────────────────────────────────── *@
    <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">

        @* Logo circular clickeable *@
        <div class="shrink-0 flex justify-center sm:justify-start">
            <button class="w-20 h-20 md:w-24 md:h-24 lg:w-28 lg:h-28 rounded-full bg-black overflow-hidden ring-2 ring-base-300 shadow-md cursor-pointer hover:ring-primary hover:ring-4 transition-all"
                    @onclick="OpenLogo"
                    title="Ver logo completo">
                <img src="img/TradeCompliance.png"
                     alt="Trade Compliance logo"
                     class="w-full h-full object-cover" />
            </button>
        </div>

        @* Texto *@
        <div class="flex-1 min-w-0 text-center sm:text-left">
            <p class="text-xs font-semibold uppercase tracking-widest text-base-content/50 mb-1">Panel de control</p>
            <h1 class="text-fluid-3xl font-bold text-base-content leading-tight">
                @if (!string.IsNullOrEmpty(_displayName))
                {
                    <span>Bienvenido, @_displayName</span>
                }
                else
                {
                    <span>Compliance Control Center</span>
                }
            </h1>
            <p class="text-base-content/60 mt-1 text-fluid-sm">
                Portal centralizado de módulos de cumplimiento — OEA y CTPAT.
            </p>
        </div>

        @* Fecha *@
        <div class="shrink-0 text-center sm:text-right hidden md:block">
            <p class="text-fluid-xl font-semibold text-base-content">@_today.ToString("MMM yyyy")</p>
            <p class="text-fluid-sm text-base-content/50">@_today.ToString("dddd d 'de' MMMM", new System.Globalization.CultureInfo("es-MX"))</p>
        </div>

    </div>

    @* ── Gráficas ─────────────────────────────────────────────── *@
    @if (_loading)
    {
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body gap-3">
                    <div class="skeleton h-4 w-32 rounded"></div>
                    <div class="skeleton h-56 w-full rounded"></div>
                </div>
            </div>
            <div class="card bg-base-100 border border-base-300">
                <div class="card-body gap-3">
                    <div class="skeleton h-4 w-32 rounded"></div>
                    <div class="skeleton h-56 w-full rounded"></div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 xl:grid-cols-2 gap-4">

            @* Gráfica OEA — Donut de estatus del mes *@
            <div class="card bg-base-100 border border-base-300 min-w-0">
                <div class="card-body">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <h3 class="font-semibold text-base-content truncate">OEA — Estatus del mes</h3>
                            <p class="text-xs text-base-content/50 truncate">@_today.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-MX")) · @_oeaCompleted/@_oeaTotal completadas</p>
                        </div>
                        <span class="badge @(_oeaPct >= 80 ? "badge-success" : _oeaPct >= 50 ? "badge-warning" : "badge-error") badge-soft shrink-0">@_oeaPct%</span>
                    </div>
                    @* @key fuerza a Blazor a destruir/recrear el chart al cambiar el tema,
                       garantizando repintado limpio en modo claro/oscuro. *@
                    <EChart Options="@_oeaChartJson" Style="height: 260px; width: 100%;" ThemeKey="@Theme.Current" />
                </div>
            </div>

            @* Gráfica CTPAT — Barras por criterio *@
            <div class="card bg-base-100 border border-base-300 min-w-0">
                <div class="card-body">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <h3 class="font-semibold text-base-content truncate">CTPAT — Avance por criterio</h3>
                            <p class="text-xs text-base-content/50 truncate">Año @_today.Year · @_ctpatAnswered/139 revisadas · @_ctpatFiles archivos</p>
                        </div>
                        <span class="badge badge-secondary badge-soft shrink-0">@_ctpatAnswered/139</span>
                    </div>
                    <EChart Options="@_ctpatChartJson" Style="height: 280px; width: 100%;" ThemeKey="@Theme.Current" />
                </div>
            </div>

        </div>
    }

    @* ── Módulos ──────────────────────────────────────────────── *@
    <div>
        <h2 class="text-sm font-semibold uppercase tracking-widest text-base-content/50 mb-3">Módulos</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

            @* OEA *@
            <div class="card bg-base-100 border border-base-300 hover:border-primary hover:shadow-md transition-all">
                <div class="card-body gap-4">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-primary text-primary-content flex items-center justify-center shrink-0 font-bold text-lg">
                            OEA
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="card-title text-base">OEA — Checklist mensual</h3>
                            <p class="text-sm text-base-content/60 mt-0.5">
                                Seguimiento de cumplimiento OEA (RGCE 7.1.1, Perfil E3) con matriz mensual, adjuntos y auditoría.
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-1 border-t border-base-200">
                        <a href="oea" class="btn btn-sm btn-primary">Checklist</a>
                        <a href="oea/matrix" class="btn btn-sm btn-ghost">Matriz &amp; Auditoría</a>
                    </div>
                </div>
            </div>

            @* CTPAT *@
            <div class="card bg-base-100 border border-base-300 hover:border-secondary hover:shadow-md transition-all">
                <div class="card-body gap-4">
                    <div class="flex items-start gap-4">
                        <div class="w-12 h-12 rounded-xl bg-secondary text-secondary-content flex items-center justify-center shrink-0 font-bold text-sm">
                            CTPAT
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="card-title text-base">CTPAT — Revisión anual</h3>
                            <p class="text-sm text-base-content/60 mt-0.5">
                                Revisión anual del perfil CTPAT (139 preguntas) con carga de evidencias y dashboard de avance.
                            </p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 pt-1 border-t border-base-200">
                        <a href="ctpat" class="btn btn-sm btn-secondary">Revisión</a>
                        <a href="ctpat/dashboard" class="btn btn-sm btn-ghost">Dashboard</a>
                        <a href="ctpat/matrix" class="btn btn-sm btn-ghost">Matriz</a>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>

@code {
    // ── Estado general ─────────────────────────────────────────
    private string? _displayName;
    private DateTime _today = DateTime.Now;
    private bool _loading = true;
    private bool _logoModalOpen;

    // ── Stats ──────────────────────────────────────────────────
    private int _oeaCompleted;
    private int _oeaTotal;
    private int _oeaPct;
    private int _ctpatAnswered;
    private int _ctpatFiles;

    // ── Chart JSON para ECharts ────────────────────────────────
    private string _oeaChartJson = "{}";
    private string _ctpatChartJson = "{}";

    // Colores fijos por estado
    private static readonly Dictionary<string, string> StatusColors = new()
    {
        ["Pendiente"]   = "#94a3b8",
        ["En Progreso"] = "#3b82f6",
        ["Completado"]  = "#22c55e",
        ["Vencido"]     = "#ef4444",
        ["N/A"]         = "#d1d5db",
    };

    // ── Lifecycle ─────────────────────────────────────────────
    protected override void OnInitialized()
    {
        Theme.OnChange += OnThemeChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await UserSession.GetCurrentAsync();
        _displayName = user?.DisplayName ?? user?.UserName;

        var now = DateTime.Now;

        // OEA stats
        _oeaTotal = await Db.Activities.CountAsync(a => a.IsActive);

        var oeaCounts = await Db.MonthlyStatuses
            .Where(m => m.Year == now.Year && m.Month == now.Month)
            .GroupBy(m => m.Status)
            .Select(g => new { Status = g.Key, Count = g.Count() })
            .ToListAsync();

        int pendiente  = oeaCounts.FirstOrDefault(x => x.Status == ComplianceStatus.Pendiente)?.Count  ?? 0;
        int enProgreso = oeaCounts.FirstOrDefault(x => x.Status == ComplianceStatus.EnProgreso)?.Count ?? 0;
        int completado = oeaCounts.FirstOrDefault(x => x.Status == ComplianceStatus.Completado)?.Count ?? 0;
        int vencido    = oeaCounts.FirstOrDefault(x => x.Status == ComplianceStatus.Vencido)?.Count    ?? 0;
        int na         = oeaCounts.FirstOrDefault(x => x.Status == ComplianceStatus.NA)?.Count         ?? 0;

        // Activities sin registro cuentan como Pendiente
        int sinRegistro = _oeaTotal - oeaCounts.Sum(x => x.Count);
        pendiente += sinRegistro;

        _oeaCompleted = completado;
        _oeaPct = _oeaTotal > 0 ? (int)Math.Round(completado * 100.0 / _oeaTotal) : 0;

        // Build OEA donut JSON
        var oeaItems = new (string Label, int Count, string Color)[]
        {
            ("Pendiente",   pendiente,  StatusColors["Pendiente"]),
            ("En Progreso", enProgreso, StatusColors["En Progreso"]),
            ("Completado",  completado, StatusColors["Completado"]),
            ("Vencido",     vencido,    StatusColors["Vencido"]),
            ("N/A",         na,         StatusColors["N/A"]),
        }.Where(p => p.Count > 0).ToArray();

        _oeaChartJson = BuildDonutJson(oeaItems, "actividades");

        // CTPAT stats
        _ctpatAnswered = await Db.CtpatReviews
            .CountAsync(r => r.Year == now.Year && r.Status != CtpatReviewStatus.Pendiente);

        _ctpatFiles = await Db.CtpatReviewFiles
            .CountAsync(f => f.Review.Year == now.Year);

        var allStats = await CtpatReviewService.GetStatsByCriterioAsync(now.Year);
        var ctpatItems = allStats.OrderBy(s => s.PctAvance)
            .Select(s => new { Label = ShortCriterio(s.Criterio), Value = s.PctAvance })
            .ToArray();

        _ctpatChartJson = BuildBarJson(
            ctpatItems.Select(x => x.Label).ToArray(),
            ctpatItems.Select(x => (double)x.Value).ToArray());

        _loading = false;
    }

    // ── Tema ───────────────────────────────────────────────────
    private async void OnThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Theme.OnChange -= OnThemeChanged;
    }

    // ── Helpers ────────────────────────────────────────────────
    private void OpenLogo()  => _logoModalOpen = true;
    private void CloseLogo() => _logoModalOpen = false;

    private static string ShortCriterio(string criterio)
    {
        return criterio.Length > 22 ? criterio[..22] + "..." : criterio;
    }

    // ── ECharts JSON builders ─────────────────────────────────
    private static string BuildDonutJson(
        (string Label, int Count, string Color)[] items,
        string unitLabel)
    {
        var dataArr = items.Select(i => new
        {
            value = i.Count,
            name = i.Label,
            itemStyle = new { color = i.Color }
        });

        var options = new
        {
            tooltip = new
            {
                trigger = "item",
                formatter = $"{{b}}: {{c}} {unitLabel} ({{d}}%)"
            },
            legend = new
            {
                bottom = "0%",
                left = "center",
                textStyle = new { fontSize = 11 }
            },
            series = new object[]
            {
                new
                {
                    type = "pie",
                    radius = new[] { "45%", "70%" },
                    center = new[] { "50%", "45%" },
                    avoidLabelOverlap = true,
                    padAngle = 2,
                    itemStyle = new { borderRadius = 4 },
                    label = new { show = false },
                    emphasis = new
                    {
                        label = new { show = true, fontSize = 14, fontWeight = "bold" }
                    },
                    data = dataArr
                }
            },
            animationType = "scale",
            animationEasing = "elasticOut"
        };

        return JsonSerializer.Serialize(options);
    }

    private static string BuildBarJson(string[] labels, double[] values)
    {
        var options = new
        {
            tooltip = new
            {
                trigger = "axis",
                axisPointer = new { type = "shadow" },
                formatter = "{b}: {c}%"
            },
            grid = new { left = "3%", right = "6%", bottom = "3%", top = "3%", containLabel = true },
            xAxis = new
            {
                type = "value",
                min = 0,
                max = 100,
                splitLine = new { show = true, lineStyle = new { type = "dashed" } },
                axisLabel = new { formatter = "{value}%" }
            },
            yAxis = new
            {
                type = "category",
                data = labels,
                axisLabel = new { fontSize = 11 }
            },
            series = new object[]
            {
                new
                {
                    type = "bar",
                    data = values,
                    itemStyle = new { borderRadius = new[] { 0, 5, 5, 0 } },
                    barMaxWidth = 24,
                    colorBy = "data"
                }
            },
            animationEasing = "cubicOut"
        };

        return JsonSerializer.Serialize(options);
    }
}
