@page "/"
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Compliance Control Center</PageTitle>

<div class="p-6 lg:p-8 max-w-5xl mx-auto">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-base-content">Compliance Control Center</h1>
        <p class="text-base-content/60 mt-2">
            Portal centralizado de módulos de cumplimiento. Selecciona un módulo para empezar.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @foreach (var m in Modules)
        {
            @if (m.Enabled)
            {
                <a href="@m.Href"
                   class="card bg-base-100 border border-base-300 hover:border-primary hover:shadow-md transition-all">
                    <div class="card-body">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 rounded-lg @m.BadgeClass flex items-center justify-center shrink-0">
                                <span class="font-bold text-lg">@m.Badge</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <h2 class="card-title text-lg">@m.Title</h2>
                                <p class="text-sm text-base-content/60 mt-1">@m.Description</p>
                            </div>
                        </div>
                    </div>
                </a>
            }
            else
            {
                <div class="card bg-base-100 border border-base-300 opacity-60 cursor-not-allowed">
                    <div class="card-body">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 rounded-lg bg-base-300 flex items-center justify-center shrink-0">
                                <span class="font-bold text-lg text-base-content/40">@m.Badge</span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <h2 class="card-title text-lg">@m.Title</h2>
                                    <span class="badge badge-ghost badge-sm">Próximamente</span>
                                </div>
                                <p class="text-sm text-base-content/60 mt-1">@m.Description</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private record ModuleCard(string Badge, string Title, string Description, string Href, string BadgeClass, bool Enabled);

    private static readonly ModuleCard[] Modules =
    {
        new("OEA",   "OEA — Checklist mensual",       "Seguimiento de cumplimiento OEA (RGCE 7.1.1, Perfil E3) con matriz mensual, adjuntos y auditoría.", "oea",   "bg-primary text-primary-content",   Enabled: true),
        new("CTPAT", "CTPAT — Revisión anual",        "Revisión anual del perfil CTPAT (139 preguntas) con carga de evidencias.",                          "ctpat", "bg-secondary text-secondary-content", Enabled: true),
    };
}
