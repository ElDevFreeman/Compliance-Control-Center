@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@inject ThemeState Theme

@* Layout independiente para páginas de Account (Login, Register, etc.)
   Sin sidebar — solo el contenido ocupa toda la ventana. *@

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    <div class="flex flex-col h-screen bg-base-100">
        <main class="flex-1 min-h-0 flex flex-col">
            @Body
        </main>
    </div>

    <div id="blazor-error-ui" class="hidden">
        <span class="alert alert-error">
            Ha ocurrido un error no controlado.
            <a href="" class="link">Recargar</a>
        </span>
    </div>
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // If this code runs, we're currently rendering in interactive mode, so there is no HttpContext.
            // The identity pages need to set cookies, so they require an HttpContext. To achieve this we
            // must transition back from interactive mode to a server-rendered page.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
