<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config para IIS + ASP.NET Core Module V2 (ANCM).

  Durante 'dotnet publish', MSBuild transforma este archivo:
  reemplaza processPath / arguments con los valores reales del
  binario publicado. Los demás atributos y elementos personalizados
  se preservan.

  stdoutLogEnabled="true" hace que ANCM redirija stdout/stderr del
  proceso .NET a archivos bajo .\logs\. Esto es la única forma
  práctica de ver los logs de la app en producción bajo IIS cuando
  no hay otro sink (Serilog, Application Insights, etc.) configurado.

  IMPORTANTE:
  - La carpeta 'logs' debe existir en el sitio publicado y el AppPool
    identity debe tener permisos de escritura en ella. 'dotnet publish'
    la crea automáticamente porque estamos referenciándola aquí.
  - Después de diagnosticar el problema, considera poner
    stdoutLogEnabled="false" para no llenar el disco.

  urlCompression deshabilitado:
  - En la red corporativa de Corning se ha visto que IIS/proxies
    recomprimen respuestas en tránsito, corrompiendo bodies binarios
    (wasm) y potencialmente cuerpos de POST. Se replica el patrón
    usado en FDS.WebAssembly como precaución.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\ComplianceControlCenter.Web.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Puedes forzar Development temporalmente para ver la DeveloperExceptionPage. -->
          <!-- <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Development" /> -->
        </environmentVariables>
      </aspNetCore>
      <urlCompression doStaticCompression="false" doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>

