@* Tarjeta KPI estilo Southbound: fondo saturado con color de contenido + icono.
   Variante "neutral" usa card estándar con card-border.
   Soporta Icon (material-symbols-outlined) o IconPath (SVG path heredado). *@

@{
    var (bgCls, textCls) = Variant switch
    {
        "success" => ("bg-success",  "text-success-content"),
        "warning" => ("bg-warning",  "text-warning-content"),
        "error"   => ("bg-error",    "text-error-content"),
        "info"    => ("bg-info",     "text-info-content"),
        "primary" => ("bg-primary",  "text-primary-content"),
        _         => ("bg-base-100", "text-base-content")
    };

    var isNeutral = Variant == "neutral";
    var wrapperCls = isNeutral
        ? "card card-border bg-base-100 border-base-300 scale-in smooth hover:-translate-y-0.5 hover:shadow-md"
        : $"{bgCls} {textCls} rounded-box shadow-sm scale-in smooth hover:-translate-y-0.5 hover:shadow-md";
    // Padding reducido: p-3 (12px) en vez de p-5 (20px). Compensa mejor Windows a 150%
    // y da más aire al contenido cuando el ancho útil es pequeño.
    var innerCls = isNeutral ? "card-body p-3 gap-1" : "p-3";
}

<div class="@wrapperCls">
    <div class="@innerCls">
        <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-medium truncate @(isNeutral ? "text-base-content/60 uppercase tracking-wider" : "opacity-90")">
                @Label
            </span>
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="material-symbols-outlined text-[18px] leading-none shrink-0 @(isNeutral ? "text-base-content/40" : "opacity-80")">
                    @Icon
                </span>
            }
            else if (!string.IsNullOrEmpty(IconPath))
            {
                <svg xmlns="http://www.w3.org/2000/svg"
                     class="h-4 w-4 shrink-0 @(isNeutral ? "text-base-content/40" : "opacity-80")"
                     fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="@IconPath" />
                </svg>
            }
        </div>
        <div class="mt-0.5 text-fluid-xl font-bold tabular-nums leading-tight truncate">@Value</div>
        @if (!string.IsNullOrEmpty(SubText))
        {
            <div class="mt-0.5 text-[11px] @(isNeutral ? "text-base-content/50" : "opacity-80")">@SubText</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? SubText { get; set; }
    /// <summary>primary | success | warning | error | info | neutral</summary>
    [Parameter] public string Variant { get; set; } = "primary";
    /// <summary>Nombre de icono material-symbols-outlined (preferido).</summary>
    [Parameter] public string? Icon { get; set; }
    /// <summary>Path SVG heredado (usar Icon en su lugar para nuevos componentes).</summary>
    [Parameter] public string? IconPath { get; set; }
}
