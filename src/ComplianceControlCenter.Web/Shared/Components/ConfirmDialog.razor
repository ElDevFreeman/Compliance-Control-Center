@* Modal de confirmación reutilizable con daisyUI. *@

@if (_visible)
{
    <div class="modal modal-open modal-backdrop-in" role="dialog" aria-modal="true">
        <div class="modal-box border border-base-300 modal-in">
            <h3 class="font-bold text-lg">@Title</h3>
            <p class="py-4 text-base-content/80">@Message</p>
            <div class="modal-action">
                <button class="btn btn-ghost smooth" @onclick="Cancel">@CancelText</button>
                <button class="btn @ConfirmClass smooth" @onclick="Confirm">@ConfirmText</button>
            </div>
        </div>
        <div class="modal-backdrop bg-black/40" @onclick="Cancel"></div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Confirmar";
    [Parameter] public string Message { get; set; } = "¿Estás seguro?";
    [Parameter] public string ConfirmText { get; set; } = "Confirmar";
    [Parameter] public string CancelText { get; set; } = "Cancelar";
    /// <summary>btn-error, btn-warning, btn-primary, etc.</summary>
    [Parameter] public string ConfirmClass { get; set; } = "btn-primary";

    private bool _visible;
    private TaskCompletionSource<bool>? _tcs;

    public Task<bool> ShowAsync()
    {
        _tcs = new TaskCompletionSource<bool>();
        _visible = true;
        StateHasChanged();
        return _tcs.Task;
    }

    public Task<bool> ShowAsync(string title, string message, string confirmText = "Confirmar", string confirmClass = "btn-primary")
    {
        Title = title;
        Message = message;
        ConfirmText = confirmText;
        ConfirmClass = confirmClass;
        return ShowAsync();
    }

    private void Confirm()
    {
        _visible = false;
        _tcs?.TrySetResult(true);
    }

    private void Cancel()
    {
        _visible = false;
        _tcs?.TrySetResult(false);
    }
}
