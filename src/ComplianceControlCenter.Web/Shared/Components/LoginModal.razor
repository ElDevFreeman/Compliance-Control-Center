@* Modal global de inicio de sesión.
   Se abre por cualquier componente vía LoginModalState.Open().
   Vive en MainLayout, escucha el evento y renderiza el diálogo.

   ESTRATEGIA (post-diagnóstico HTTP 400 en producción):
   No hacemos POST directo desde el modal a /Account/Login porque el token
   antiforgery generado en el prerender se pierde en el ciclo interactivo
   (HttpContext no está disponible en InteractiveServer), y el POST llega
   sin token válido → 400.

   En su lugar, al abrir el modal simplemente redirigimos a /Account/Login
   con ReturnUrl. Esa página usa EditForm con antiforgery estándar de
   Blazor 8, que funciona correctamente porque su prerender ES el que
   emite el token justo antes del render final. *@

@using Microsoft.AspNetCore.WebUtilities
@implements IDisposable
@inject LoginModalState State
@inject NavigationManager Nav

@* El modal ya no renderiza UI. Solo escucha el evento y navega a /Account/Login. *@

@code {
    protected override void OnInitialized()
    {
        State.OnOpenRequested += HandleOpenRequested;
    }

    private void HandleOpenRequested(string? returnUrl)
    {
        // Determinar la URL destino tras login (relativa al PathBase).
        var target = returnUrl ?? Nav.ToBaseRelativePath(Nav.Uri);
        target = StripModalQueryParams(target);

        // Construir URL absoluta a /Account/Login con ReturnUrl.
        // Nav.BaseUri respeta el PathBase (/CCC/), así que "Account/Login"
        // relativo resuelve a /CCC/Account/Login correctamente.
        var loginUri = Nav.ToAbsoluteUri("Account/Login").ToString();

        if (!string.IsNullOrWhiteSpace(target))
        {
            loginUri = QueryHelpers.AddQueryString(loginUri, "ReturnUrl", target);
        }

        // forceLoad: true para que la navegación sea un GET HTTP real, no un
        // enhanced-nav de Blazor (que en algunos casos comparte estado con la
        // sesión actual y no re-renderiza el prerender de forma limpia).
        Nav.NavigateTo(loginUri, forceLoad: true);
    }

    private static string StripModalQueryParams(string relativeOrAbs)
    {
        if (string.IsNullOrEmpty(relativeOrAbs)) return relativeOrAbs;

        var qIdx = relativeOrAbs.IndexOf('?');
        if (qIdx < 0) return relativeOrAbs;

        var path = relativeOrAbs.Substring(0, qIdx);
        var q    = QueryHelpers.ParseQuery(relativeOrAbs.Substring(qIdx));

        q.Remove("openLogin");
        q.Remove("loginError");

        var kept = new Dictionary<string, string?>();
        foreach (var kv in q) kept[kv.Key] = kv.Value.ToString();

        return kept.Count == 0 ? path : QueryHelpers.AddQueryString(path, kept);
    }

    public void Dispose()
    {
        State.OnOpenRequested -= HandleOpenRequested;
    }
}
