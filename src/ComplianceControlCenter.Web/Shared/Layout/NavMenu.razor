@* NavMenu - Sidebar colapsable con el patrón oficial daisyUI:
   `is-drawer-open:` y `is-drawer-close:` reaccionan automáticamente al
   estado del checkbox <input class="drawer-toggle">.

   Requiere InteractiveServer para que el toggle de tema y otros @onclick
   del sidebar respondan al usuario (el layout por defecto es SSR estático). *@
@rendermode InteractiveServer
@implements IDisposable
@inject IJSRuntime JS
@inject ThemeState Theme
@inject NavigationManager Nav
@inject LoginModalState LoginModal

<div class="bg-base-100 border-r border-base-300 flex flex-col min-h-full is-drawer-open:w-64 is-drawer-close:w-16 transition-[width] duration-200 ease-out">
    <!-- Marca + toggle colapsar -->
    <div class="flex items-center gap-3 p-3 is-drawer-close:flex-col is-drawer-close:gap-2">
        <div class="w-9 h-9 flex items-center justify-center shrink-0">
            <img src="img/lobo.png" alt="Logo" class="w-9 h-9 object-contain" />
        </div>
        <div class="min-w-0 flex-1 is-drawer-close:hidden">
            <h2 class="font-semibold text-base-content text-sm truncate">Compliance Control Center</h2>
            <p class="text-xs text-base-content/50 truncate">Auditoría mensual</p>
        </div>
        <label for="sidebar-drawer"
               class="btn btn-ghost btn-xs btn-square text-base-content/50 hover:text-base-content shrink-0 hidden lg:inline-flex"
               title="Colapsar/expandir">
            <span class="material-symbols-outlined text-[18px] leading-none transition-transform is-drawer-close:rotate-180">keyboard_double_arrow_left</span>
        </label>
    </div>

    <!-- Navegación -->
    <ul class="menu w-full grow px-2 gap-1">
        <!-- Inicio: link directo (no es grupo) -->
        <li class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Inicio">
            <NavLink href=""
                     Match="NavLinkMatch.All"
                     ActiveClass="menu-active"
                     class="rounded-lg is-drawer-close:justify-center is-drawer-close:px-0">
                <span class="material-symbols-outlined text-[18px] leading-none shrink-0">home</span>
                <span class="is-drawer-close:hidden truncate">Inicio</span>
            </NavLink>
        </li>

        <!-- Módulos con sub-items -->
        @foreach (var module in Modules)
        {
            <li class="menu-none is-drawer-open:block is-drawer-close:hidden">
                @* MODO EXPANDIDO: grupo desplegable con <details>/<summary>.
                   El atributo 'open' se controla vía _openGroups (todos abiertos por default). *@
                <details open="@_openGroups.Contains(module.Key)">
                    <summary class="rounded-lg font-medium"
                             @onclick:preventDefault="false"
                             @onclick="() => ToggleGroup(module.Key)">
                        <span class="material-symbols-outlined text-[18px] leading-none shrink-0">@module.Icon</span>
                        <span class="truncate">@module.Label</span>
                    </summary>
                    <ul>
                        @foreach (var item in module.Items)
                        {
                            <li>
                                <NavLink href="@item.Href"
                                         Match="NavLinkMatch.All"
                                         ActiveClass="menu-active"
                                         class="rounded-lg">
                                    <span class="material-symbols-outlined text-[18px] leading-none shrink-0">@item.Icon</span>
                                    <span class="truncate">@item.Label</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                </details>
            </li>

            @* MODO COLAPSADO: dropdown flyout hacia la derecha con las sub-opciones. *@
            <li class="is-drawer-open:hidden is-drawer-close:block">
                <div class="dropdown dropdown-right">
                    <div tabindex="0" role="button"
                         class="rounded-lg justify-center px-0 tooltip tooltip-right"
                         data-tip="@module.Label">
                        <span class="material-symbols-outlined text-[18px] leading-none shrink-0">@module.Icon</span>
                    </div>
                    <ul tabindex="0"
                        class="dropdown-content menu bg-base-100 rounded-box border border-base-300 shadow-lg w-56 ml-2 z-50 p-2 dropdown-in">
                        <li class="menu-title">
                            <span>@module.Label</span>
                        </li>
                        @foreach (var item in module.Items)
                        {
                            <li>
                                <NavLink href="@item.Href"
                                         Match="NavLinkMatch.All"
                                         ActiveClass="menu-active"
                                         class="rounded-lg">
                                    <span class="material-symbols-outlined text-[18px] leading-none shrink-0">@item.Icon</span>
                                    <span class="truncate">@item.Label</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                </div>
            </li>
        }

        <AuthorizeView Roles="Admin">
            <li class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Usuarios">
                <NavLink href="users"
                         Match="NavLinkMatch.Prefix"
                         ActiveClass="menu-active"
                         class="rounded-lg is-drawer-close:justify-center is-drawer-close:px-0">
                    <span class="material-symbols-outlined text-[18px] leading-none shrink-0">manage_accounts</span>
                    <span class="is-drawer-close:hidden truncate">Usuarios</span>
                </NavLink>
            </li>
        </AuthorizeView>
    </ul>

    <!-- Pie: theme toggle + sesión -->
    <div class="px-2 pb-3">
        <div class="border-t border-base-300 my-2"></div>

        <ul class="menu w-full gap-1">
            <!-- Theme toggle: usa daisyUI theme-controller (CSS puro).
                 El checkbox nativo aplica el tema por CSS sin depender de JS.
                 El @onchange sólo persiste el valor y sincroniza el estado C#. -->
            <li class="is-drawer-close:tooltip is-drawer-close:tooltip-right"
                data-tip="@(Theme.IsDark ? "Modo claro" : "Modo oscuro")">
                <label class="rounded-lg is-drawer-close:justify-center is-drawer-close:px-0 cursor-pointer">
                     <input type="checkbox"
                            value="@ThemeState.DarkTheme"
                            class="theme-controller swap swap-rotate hidden"
                            checked="@Theme.IsDark"
                            @onchange="OnThemeToggleChanged" />
                    <span class="material-symbols-outlined text-[18px] leading-none shrink-0">
                        @(Theme.IsDark ? "light_mode" : "dark_mode")
                    </span>
                    <span class="is-drawer-close:hidden truncate">
                        @(Theme.IsDark ? "Modo claro" : "Modo oscuro")
                    </span>
                </label>
            </li>

            <!-- Sesión -->
            <AuthorizeView>
                <Authorized>
                    @{
                        var displayName = context.User.FindFirst("DisplayName")?.Value
                                        ?? context.User.Identity?.Name
                                        ?? "";
                        var initial = string.IsNullOrEmpty(displayName)
                            ? "?"
                            : displayName[0].ToString().ToUpper();
                    }
                    <li class="dropdown is-drawer-open:dropdown-top is-drawer-open:dropdown-end is-drawer-close:dropdown-right w-full">
                        <div tabindex="0"
                             role="button"
                             class="rounded-lg is-drawer-close:justify-center is-drawer-close:px-0"
                             aria-label="Menú de usuario">
                            <span class="inline-flex items-center justify-center h-4 w-4 shrink-0 rounded-full bg-primary text-primary-content text-[9px] font-semibold leading-none">
                                @initial
                            </span>
                            <span class="is-drawer-close:hidden truncate">@displayName</span>
                        </div>
                        <div tabindex="0"
                         class="dropdown-content bg-base-100 text-base-content rounded-box border border-base-300 shadow-lg w-56 z-50
                                     is-drawer-open:mb-2 is-drawer-close:ml-2
                                     is-drawer-close:top-auto! is-drawer-close:bottom-0!
                                     overflow-hidden dropdown-in">
                            <div class="p-2">
                                <form action="Account/Logout" method="post" data-enhance="false">
                                    <AntiforgeryToken />
                                    <input type="hidden" name="ReturnUrl" value="" />
                                    <button type="submit"
                                            class="btn btn-ghost btn-sm w-full justify-start gap-3 font-normal text-error hover:bg-error/10">
                                        <span class="material-symbols-outlined text-[18px] leading-none shrink-0">logout</span>
                                        <span>Cerrar sesión</span>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </li>
                </Authorized>
                <NotAuthorized>
                    <li class="is-drawer-close:tooltip is-drawer-close:tooltip-right" data-tip="Iniciar sesión">
                        <button type="button"
                                @onclick="OpenLoginModal"
                                class="rounded-lg is-drawer-close:justify-center is-drawer-close:px-0">
                            <span class="material-symbols-outlined text-[18px] leading-none shrink-0">login</span>
                            <span class="is-drawer-close:hidden truncate">Iniciar sesión</span>
                        </button>
                    </li>
                </NotAuthorized>
            </AuthorizeView>
        </ul>

        <div class="px-3 py-2 is-drawer-close:hidden">
            <p class="text-xs text-base-content/40">v1.0.0</p>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Theme.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
    }

    private void OpenLoginModal() => LoginModal.Open();

    private async Task OnThemeToggleChanged(ChangeEventArgs e)
    {
        // El checkbox theme-controller ya aplicó el tema visualmente vía CSS.
        // Aquí sincronizamos el estado C# y persistimos la elección.
        var isChecked = e.Value is bool b && b;
        Theme.Set(isChecked ? ThemeState.DarkTheme : ThemeState.LightTheme);
        try
        {
            await JS.InvokeVoidAsync("cccTheme.set", Theme.Current);
        }
        catch { /* JS no disponible; el CSS ya aplicó el tema */ }
    }

    // ────────────────────────────────────────────────────────────────
    // Modelo de navegación agrupada por módulo
    // ────────────────────────────────────────────────────────────────
    private record NavItem(string Href, string Label, string Icon);
    private record NavModule(string Key, string Label, string Icon, NavItem[] Items);

    /// <summary>Estado de expansión de cada grupo. Por defecto todos abiertos.</summary>
    private HashSet<string> _openGroups = new(new[] { "oea", "ctpat" }, StringComparer.Ordinal);

    private void ToggleGroup(string key)
    {
        if (!_openGroups.Add(key)) _openGroups.Remove(key);
    }

    /// <summary>Módulos y sus sub-páginas. Extender aquí para agregar nuevos módulos.</summary>
    private static readonly NavModule[] Modules =
    {
        new NavModule(
            Key: "oea",
            Label: "OEA",
            Icon: "verified_user",
            Items: new[]
            {
                new NavItem("oea",        "Checklist mensual",  "checklist"),
                new NavItem("oea/matrix", "Matriz & Auditoría", "grid_view"),
            }
        ),
        new NavModule(
            Key: "ctpat",
            Label: "CTPAT",
            Icon: "shield",
            Items: new[]
            {
                new NavItem("ctpat",           "Revisión anual", "fact_check"),
                new NavItem("ctpat/dashboard", "Dashboard",      "dashboard"),
                new NavItem("ctpat/matrix",    "Matriz",         "grid_view"),
            }
        ),
    };
}
