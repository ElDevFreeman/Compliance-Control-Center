@* Botón standalone para cambiar tema. Persiste el tema en localStorage vía cccTheme. *@
@implements IDisposable
@inject ThemeState Theme
@inject IJSRuntime JS

<button class="btn btn-ghost btn-circle"
        title="@(Theme.IsDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro")"
        aria-label="Cambiar tema"
        @onclick="ToggleAsync">
    @if (Theme.IsDark)
    {
        <!-- Sol -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
             viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
    }
    else
    {
        <!-- Luna -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none"
             viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
    }
</button>

@code {
    protected override void OnInitialized() => Theme.OnChange += StateHasChanged;

    public void Dispose() => Theme.OnChange -= StateHasChanged;

    private async Task ToggleAsync()
    {
        Theme.Toggle();
        try
        {
            await JS.InvokeVoidAsync("cccTheme.set", Theme.Current);
        }
        catch { /* JS aún no disponible; ignorar */ }
    }
}
