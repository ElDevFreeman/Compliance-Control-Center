@page "/ctpat/matrix"
@rendermode InteractiveServer
@implements IDisposable

@using System.Text.Json
@inject ICtpatCatalogService Catalog
@inject ICtpatReviewService Reviews
@inject IAuditService AuditSvc
@inject ThemeState Theme

<PageTitle>CTPAT · Matriz</PageTitle>

<div class="flex flex-col gap-4">

<div class="flex flex-wrap items-end justify-between gap-3">
    <div>
        <h1 class="text-2xl font-bold text-base-content">CTPAT · Matriz de revisión</h1>
        <p class="text-sm text-base-content/60">Vista consolidada de preguntas y estados de revisión por criterio</p>
    </div>
</div>

<!-- ── Tabs ──────────────────────────────────────────────────── -->
<div role="tablist" class="tabs tabs-border">
    <button role="tab"
            class="tab smooth @(_activeTab == "matrix" ? "tab-active" : "")"
            @onclick='() => SetTab("matrix")'>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        Matriz
    </button>
    <button role="tab"
            class="tab smooth @(_activeTab == "audit" ? "tab-active" : "")"
            @onclick='() => SetTab("audit")'>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Auditoría
        @if (_logs is not null)
        {
            <span class="badge badge-ghost badge-sm ml-2">@_logs.Count</span>
        }
    </button>
</div>

@if (_activeTab == "matrix")
{
    <!-- ── Filtros + Pie chart ──────────────────────────────── -->
    <div class="card card-border bg-base-100 border-base-300">
        <div class="card-body px-5 py-3 gap-0">
            <div class="flex flex-col lg:flex-row lg:items-stretch gap-4">

                <!-- Lado izquierdo: filtros (~70%) -->
                <div class="flex-[7] min-w-0 flex flex-col gap-3 justify-center">
                    <div class="flex flex-wrap gap-3 items-end">
                        <fieldset class="fieldset py-0">
                            <legend class="fieldset-legend text-xs">Año</legend>
                            <input type="number" class="input input-bordered input-sm w-24"
                                   min="2020" max="2100" value="@_year"
                                   @onchange="OnYearChangedAsync" />
                        </fieldset>

                        <fieldset class="fieldset py-0">
                            <legend class="fieldset-legend text-xs">Criterio</legend>
                            <select class="select select-bordered select-sm min-w-[180px]"
                                    @bind="_filterCriterio" @bind:after="OnFilterChanged">
                                <option value="">Todos</option>
                                @foreach (var c in _criterios)
                                {
                                    <option value="@c">@c</option>
                                }
                            </select>
                        </fieldset>

                        <fieldset class="fieldset py-0">
                            <legend class="fieldset-legend text-xs">Estado</legend>
                            <select class="select select-bordered select-sm"
                                    @bind="_filterStatus" @bind:after="OnFilterChanged">
                                <option value="">Todos</option>
                                <option value="0">Pendiente</option>
                                <option value="1">Sin cambios</option>
                                <option value="2">Con cambios</option>
                                <option value="3">Revisado</option>
                            </select>
                        </fieldset>

                        <fieldset class="fieldset py-0 flex-1 min-w-[180px]">
                            <legend class="fieldset-legend text-xs">Buscar</legend>
                            <label class="input input-bordered input-sm w-full flex items-center gap-2">
                                <span class="material-symbols-outlined text-[16px] leading-none opacity-60">search</span>
                                <input type="text" class="grow" placeholder="Pregunta, revisor, cambios..."
                                       @bind="_filterText" @bind:event="oninput" @bind:after="OnFilterChanged" />
                            </label>
                        </fieldset>

                        <a href="@CsvExportHref" class="btn btn-sm btn-outline" title="Exportar CSV">
                            <span class="material-symbols-outlined text-[16px] leading-none">download</span>
                            CSV
                        </a>
                    </div>

                    <!-- Leyenda de estados -->
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-base-content/50">
                        <span>@(_questions?.Count ?? 0) preguntas</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-info inline-block"></span><span class="font-semibold text-info">@CountByStatus(CtpatReviewStatus.SinCambios)</span> Sin cambios</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-warning inline-block"></span><span class="font-semibold text-warning">@CountByStatus(CtpatReviewStatus.ConCambios)</span> Con cambios</span>
                        <span class="flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-success inline-block"></span><span class="font-semibold text-success">@CountByStatus(CtpatReviewStatus.Revisado)</span> Revisado</span>
                        <span class="font-semibold @PctClass(GlobalPct)">@GlobalPct% avance</span>
                        <span class="text-base-content/30">@Filtered.Count coinciden</span>
                    </div>
                </div>

                <!-- Separador vertical -->
                <div class="hidden lg:block w-px bg-base-300"></div>

                <!-- Lado derecho: pie chart (~30%) -->
                <div class="flex-[3] min-w-[160px] flex flex-col items-center justify-center">
                    <EChart Options="@_pieJson" Style="height: 130px; width: 100%;" ThemeKey="@Theme.Current" />
                    <span class="text-[11px] text-base-content/40 -mt-1">Distribución de estados</span>
                </div>

            </div>
        </div>
    </div>

    <!-- ── Tabla ────────────────────────────────────────────────── -->
    <div class="rounded-box border border-base-content/5 bg-base-100 overflow-hidden">
        @if (_loading)
        {
            <TableSkeleton Rows="10" Columns="8" />
        }
        else if (Filtered.Count == 0)
        {
            <div class="text-center py-16 text-base-content/60">
                @(_questions?.Count == 0 ? "Sin preguntas cargadas." : "Ninguna pregunta coincide con el filtro.")
            </div>
        }
        else
        {
            <div class="overflow-auto max-h-[60vh]">
                <table class="table table-sm table-pin-rows">
                    <thead>
                        <tr class="bg-base-200 text-base-content/70">
                            <th class="w-40 min-w-[140px]">Criterio</th>
                            <th class="w-24">ID</th>
                            <th class="min-w-[280px]">Pregunta</th>
                            <th class="w-32">Estado</th>
                            <th class="w-28">Fecha</th>
                            <th class="w-32">Revisor</th>
                            <th class="w-12 text-center"><span class="material-symbols-outlined text-[16px] leading-none">attach_file</span></th>
                            <th class="min-w-[180px]">Cambios detectados</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            var review = GetReview(row.Id);
                            var status = review?.Status ?? CtpatReviewStatus.Pendiente;
                            var (badgeClass, label) = StatusBadge(status);
                            <tr class="hover:bg-base-200/50">
                                <td>
                                    <span class="badge badge-ghost badge-sm truncate max-w-[132px]"
                                          title="@row.Criterio">
                                        @ShortCriterio(row.Criterio)
                                    </span>
                                </td>
                                <td>
                                    <span class="font-mono text-xs text-primary font-semibold">@row.ExternalId</span>
                                </td>
                                <td class="max-w-xs">
                                    <div class="line-clamp-3 text-sm" title="@row.Pregunta">@row.Pregunta</div>
                                </td>
                                <td>
                                    <span class="badge badge-soft @badgeClass badge-sm">@label</span>
                                </td>
                                <td class="font-mono text-xs text-base-content/60 whitespace-nowrap">
                                    @(review?.FechaRevision?.ToString("yyyy-MM-dd") ?? "—")
                                </td>
                                <td class="text-sm text-base-content/70 truncate max-w-[120px]"
                                    title="@review?.Revisor">
                                    @(string.IsNullOrEmpty(review?.Revisor) ? "—" : review.Revisor)
                                </td>
                                <td class="text-center">
                                    @if (review?.Files is { Count: > 0 })
                                    {
                                        <span class="badge badge-neutral badge-xs">@review.Files.Count</span>
                                    }
                                    else
                                    {
                                        <span class="text-base-content/20">—</span>
                                    }
                                </td>
                                <td class="max-w-[200px]">
                                    <div class="line-clamp-2 text-xs text-base-content/70"
                                         title="@review?.CambiosDetectados">
                                        @(string.IsNullOrWhiteSpace(review?.CambiosDetectados) ? "—" : review.CambiosDetectados)
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager TotalItems="Filtered.Count"
                   CurrentPage="_page"
                   PageSize="_pageSize"
                   CurrentPageChanged="p => _page = p"
                   PageSizeChanged="s => _pageSize = s" />
        }
    </div>
}
else
{
    <!-- ── Auditoría ─────────────────────────────────────────── -->
    <div class="card card-border bg-base-100 border-base-300 fade-in-fast">
        <div class="card-body p-3">
            <div class="flex flex-wrap gap-3 items-end">
                <fieldset class="fieldset flex-1 min-w-[220px]">
                    <legend class="fieldset-legend">Buscar</legend>
                    <label class="input input-bordered input-sm w-full flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-60" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" class="grow" placeholder="Filtrar por usuario, acción o entidad..."
                               @bind="_auditSearch" @bind:event="oninput" />
                    </label>
                </fieldset>

                <fieldset class="fieldset">
                    <legend class="fieldset-legend">Acción</legend>
                    <select class="select select-bordered select-sm" @bind="_auditAction">
                        <option value="">Todas</option>
                        @foreach (var a in _availableActions)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </fieldset>

                <button class="btn btn-sm btn-outline" @onclick="RefreshAuditAsync" title="Refrescar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Refrescar
                </button>
            </div>
        </div>
    </div>

    <div class="rounded-box border border-base-content/5 bg-base-100 overflow-hidden">
        @if (_logs is null)
        {
            <TableSkeleton Rows="8" Columns="5" />
        }
        else if (FilteredLogs.Count == 0)
        {
            <div class="text-center py-16 text-base-content/60">
                @(_logs.Count == 0 ? "Sin eventos registrados aún." : "Ningún evento coincide con el filtro.")
            </div>
        }
        else
        {
            <div class="overflow-auto max-h-[60vh]">
                <table class="table table-sm table-zebra table-pin-rows">
                    <thead>
                        <tr class="bg-base-200 text-base-content/70">
                            <th class="w-44">Fecha</th>
                            <th class="w-40">Usuario</th>
                            <th class="w-32">Acción</th>
                            <th>Entidad</th>
                            <th class="w-32">Id</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedLogs)
                        {
                            <tr class="hover:bg-base-200/50">
                                <td class="whitespace-nowrap font-mono text-xs">
                                    @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td class="text-sm">@log.User</td>
                                <td>
                                    <span class="badge badge-soft @ActionBadgeClass(log.Action) badge-sm">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="text-sm">@log.EntityName</td>
                                <td class="font-mono text-xs text-base-content/60">@log.EntityId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager TotalItems="FilteredLogs.Count"
                   CurrentPage="_auditPage"
                   PageSize="_auditPageSize"
                   CurrentPageChanged="p => _auditPage = p"
                   PageSizeChanged="s => _auditPageSize = s" />
        }
    </div>
}

</div>

@code {
    // ── Estado de tabs ────────────────────────────────────────
    private string _activeTab = "matrix";

    // ── Datos de la matriz ────────────────────────────────────
    private int _year = DateTime.Now.Year;
    private bool _loading = true;

    private List<CtpatQuestion>? _questions;
    private IReadOnlyDictionary<int, CtpatReview> _reviewMap = new Dictionary<int, CtpatReview>();
    private List<string> _criterios = new();

    private string _filterCriterio = "";
    private string _filterStatus   = "";
    private string _filterText     = "";

    private int _page     = 1;
    private int _pageSize = 25;

    // ── Pie chart ─────────────────────────────────────────────
    private string _pieJson = "{}";

    // ── Auditoría ─────────────────────────────────────────────
    private List<AuditLog>? _logs;
    private string _auditSearch = "";
    private string _auditAction = "";
    private int    _auditPage     = 1;
    private int    _auditPageSize = 25;
    private List<string> _availableActions = new();

    // ── Computed ──────────────────────────────────────────────
    private List<CtpatQuestion> Filtered
    {
        get
        {
            if (_questions is null) return new();
            IEnumerable<CtpatQuestion> q = _questions;

            if (!string.IsNullOrEmpty(_filterCriterio))
                q = q.Where(x => x.Criterio == _filterCriterio);

            if (!string.IsNullOrEmpty(_filterStatus) && int.TryParse(_filterStatus, out var s))
                q = q.Where(x => (int)(GetReview(x.Id)?.Status ?? CtpatReviewStatus.Pendiente) == s);

            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var t = _filterText.Trim().ToLowerInvariant();
                q = q.Where(x =>
                    x.Pregunta.ToLowerInvariant().Contains(t) ||
                    x.ExternalId.ToLowerInvariant().Contains(t) ||
                    (GetReview(x.Id)?.Revisor ?? "").ToLowerInvariant().Contains(t) ||
                    (GetReview(x.Id)?.CambiosDetectados ?? "").ToLowerInvariant().Contains(t));
            }

            return q.ToList();
        }
    }

    private IEnumerable<CtpatQuestion> PagedRows
    {
        get
        {
            var list = Filtered;
            var totalPages = _pageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)list.Count / _pageSize));
            if (_page > totalPages) _page = totalPages;
            if (_page < 1) _page = 1;
            return list.Skip((_page - 1) * _pageSize).Take(_pageSize);
        }
    }

    private int GlobalPct
    {
        get
        {
            if (_questions is null || _questions.Count == 0) return 0;
            var atendidas = _questions.Count(q => (GetReview(q.Id)?.Status ?? CtpatReviewStatus.Pendiente) != CtpatReviewStatus.Pendiente);
            return (int)Math.Round(atendidas * 100.0 / _questions.Count);
        }
    }

    private int CountByStatus(CtpatReviewStatus status) =>
        _questions?.Count(q => (GetReview(q.Id)?.Status ?? CtpatReviewStatus.Pendiente) == status) ?? 0;

    private string CsvExportHref =>
        $"api/ctpat/export/matrix.csv?year={_year}" +
        (string.IsNullOrEmpty(_filterCriterio) ? "" : $"&criterio={Uri.EscapeDataString(_filterCriterio)}");

    private List<AuditLog> FilteredLogs
    {
        get
        {
            if (_logs is null) return new();
            IEnumerable<AuditLog> q = _logs;
            if (!string.IsNullOrWhiteSpace(_auditAction))
                q = q.Where(l => string.Equals(l.Action, _auditAction, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_auditSearch))
            {
                var s = _auditSearch.Trim();
                q = q.Where(l =>
                    (l.User ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.Action ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.EntityName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.EntityId ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.ToList();
        }
    }

    private IEnumerable<AuditLog> PagedLogs
    {
        get
        {
            var filtered = FilteredLogs;
            var totalPages = _auditPageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)filtered.Count / _auditPageSize));
            if (_auditPage > totalPages) _auditPage = totalPages;
            if (_auditPage < 1) _auditPage = 1;
            return filtered.Skip((_auditPage - 1) * _auditPageSize).Take(_auditPageSize);
        }
    }

    // ── Ciclo de vida ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        Theme.OnChange += OnThemeChanged;
        await LoadMatrixAsync();
        await LoadAuditAsync();
    }

    private void SetTab(string tab) => _activeTab = tab;

    private async void OnThemeChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;

    // ── Handlers ─────────────────────────────────────────────
    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 2020 && y <= 2100)
        {
            _year = y;
            _page = 1;
            await LoadMatrixAsync();
        }
    }

    private void OnFilterChanged() => _page = 1;

    // ── Carga ─────────────────────────────────────────────────
    private async Task LoadMatrixAsync()
    {
        _loading = true;
        _page = 1;
        StateHasChanged();

        _questions = (await Catalog.GetQuestionsAsync()).ToList();
        _criterios = (await Catalog.GetCriteriosAsync()).ToList();
        _reviewMap = await Reviews.GetReviewsForYearAsync(_year);
        RebuildPieJson();

        _loading = false;
        StateHasChanged();
    }

    private async Task LoadAuditAsync()
    {
        _logs = (await AuditSvc.GetRecentAsync(500)).ToList();
        _availableActions = _logs
            .Select(l => l.Action)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
    }

    private async Task RefreshAuditAsync()
    {
        _logs = null;
        StateHasChanged();
        await LoadAuditAsync();
    }

    // ── Helpers ───────────────────────────────────────────────
    private CtpatReview? GetReview(int questionId) =>
        _reviewMap.TryGetValue(questionId, out var r) ? r : null;

    private static string ShortCriterio(string criterio) =>
        criterio.Length > 20 ? criterio[..18] + "…" : criterio;

    private static (string cssClass, string label) StatusBadge(CtpatReviewStatus s) => s switch
    {
        CtpatReviewStatus.Pendiente  => ("badge-ghost",   "Pendiente"),
        CtpatReviewStatus.SinCambios => ("badge-info",    "Sin cambios"),
        CtpatReviewStatus.ConCambios => ("badge-warning", "Con cambios"),
        CtpatReviewStatus.Revisado   => ("badge-primary", "Revisado"),
        _ => ("badge-ghost", s.ToString())
    };

    private static string ActionBadgeClass(string action)
    {
        var a = action?.ToLowerInvariant() ?? "";
        if (a.Contains("delete") || a.Contains("elimin")) return "badge-error";
        if (a.Contains("create") || a.Contains("add")    || a.Contains("crear")) return "badge-success";
        if (a.Contains("update") || a.Contains("edit")   || a.Contains("actualiz")) return "badge-info";
        return "badge-ghost";
    }

    private static string PctClass(int pct) => pct switch
    {
        >= 80 => "text-success",
        >= 50 => "text-warning",
        > 0   => "text-error",
        _     => "text-base-content/40"
    };

    // ── Pie chart builder ─────────────────────────────────────
    private void RebuildPieJson()
    {
        if (_questions is null) return;

        int pendiente  = CountByStatus(CtpatReviewStatus.Pendiente);
        int sinCambios = CountByStatus(CtpatReviewStatus.SinCambios);
        int conCambios = CountByStatus(CtpatReviewStatus.ConCambios);
        int revisado   = CountByStatus(CtpatReviewStatus.Revisado);

        var items = new[]
        {
            new { value = pendiente,  name = "Pendiente",   itemStyle = new { color = "#94a3b8" } },
            new { value = sinCambios, name = "Sin cambios", itemStyle = new { color = "#06b6d4" } },
            new { value = conCambios, name = "Con cambios", itemStyle = new { color = "#ef4444" } },
            new { value = revisado,   name = "Revisado",    itemStyle = new { color = "#22c55e" } },
        };

        var options = new
        {
            tooltip = new { trigger = "item", formatter = "{b}: {c} ({d}%)" },
            legend = new { bottom = 0, left = "center", itemWidth = 8, itemHeight = 8, textStyle = new { fontSize = 10 } },
            series = new object[]
            {
                new
                {
                    type = "pie",
                    radius = new[] { "40%", "68%" },
                    center = new[] { "50%", "42%" },
                    avoidLabelOverlap = true,
                    padAngle = 2,
                    itemStyle = new { borderRadius = 4 },
                    label = new { show = false },
                    emphasis = new { label = new { show = false } },
                    data = items
                }
            },
            animationType = "scale",
            animationEasing = "elasticOut"
        };
        _pieJson = JsonSerializer.Serialize(options);
    }
}
