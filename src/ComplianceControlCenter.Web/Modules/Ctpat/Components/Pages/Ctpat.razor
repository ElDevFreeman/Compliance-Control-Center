@page "/ctpat"
@rendermode InteractiveServer

@inject ICtpatCatalogService Catalog
@inject ICtpatReviewService Reviews
@inject ICtpatFileService FileService
@inject IJSRuntime JS
@inject LoginModalState LoginModal
@inject AuthenticationStateProvider AuthState
@inject UserSessionState Session
@inject CtpatPanelState PanelState

<PageTitle>CTPAT — Revisión anual</PageTitle>

<!-- =================== MAIN PAGE =================== -->
<div class="flex flex-col gap-4">

    <!-- Header -->
    <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="min-w-0 flex-1">
            <h1 class="text-fluid-2xl font-bold text-base-content">CTPAT — Revisión anual del perfil</h1>
            <p class="text-fluid-sm text-base-content/60">
                @if (_questions is null)
                {
                    <span>Cargando catálogo…</span>
                }
                else
                {
                    <span>@_questions.Count preguntas · Ciclo <strong>@_year</strong></span>
                }
            </p>
        </div>
        <div class="flex items-center gap-2 shrink-0">
            <fieldset class="fieldset py-0">
                <legend class="fieldset-legend text-xs">Año</legend>
                <input type="number" class="input input-bordered input-sm w-24"
                       min="2020" max="2100" value="@_year" @onchange="OnYearChanged" />
            </fieldset>
        </div>
    </div>

    @if (!_canEdit)
    {
        <div class="alert alert-info alert-soft shrink-0">
            <span>Estás en modo <strong>solo lectura</strong>. Puedes ver los datos y consultar la guía.
            Para editar respuestas, subir archivos o marcar avances,
            <button type="button" @onclick="() => LoginModal.Open()" class="link link-primary">inicia sesión</button>.
            </span>
        </div>
    }

    @if (_questions is null)
    {
        <TableSkeleton Rows="6" />
    }
    else
    {
        <!-- KPI + Filtros: se apila en pantallas estrechas, en fila cuando hay espacio -->
        <div class="card bg-base-100 border border-base-300">
            <div class="card-body px-5 py-3 gap-4">

                <!-- Fila 1: KPI de progreso + contadores de estado -->
                <div class="flex flex-wrap items-center gap-4 lg:gap-6">

                    <!-- Número central de avance -->
                    <div class="flex flex-col items-center shrink-0">
                        <span class="kpi-number @ProgressTextColor(Progress) tabular-nums">@Progress<span class="text-fluid-lg font-bold">%</span></span>
                        <span class="text-[11px] text-base-content/40 mt-0.5 whitespace-nowrap">@Atendidas / @_questions.Count</span>
                        <div class="w-16 bg-base-300 rounded-full h-1 mt-1.5">
                            <div class="@ProgressBarColor(Progress) h-1 rounded-full transition-all duration-500" style="width:@Progress%"></div>
                        </div>
                    </div>

                    <!-- Separador -->
                    <div class="w-px self-stretch bg-base-300 hidden sm:block"></div>

                    <!-- Contadores de estado (fluyen libremente) -->
                    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 flex-1 min-w-0">
                        <div class="flex items-center gap-1.5">
                            <div class="w-2 h-2 rounded-full bg-base-300 shrink-0"></div>
                            <div>
                                <div class="text-base font-bold text-base-content/60 leading-none tabular-nums">@CountBy(CtpatReviewStatus.Pendiente)</div>
                                <div class="text-[11px] text-base-content/40 leading-none">Pendiente</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-2 h-2 rounded-full bg-info shrink-0"></div>
                            <div>
                                <div class="text-base font-bold text-info leading-none tabular-nums">@CountBy(CtpatReviewStatus.SinCambios)</div>
                                <div class="text-[11px] text-base-content/40 leading-none">Sin cambios</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-2 h-2 rounded-full bg-error shrink-0"></div>
                            <div>
                                <div class="text-base font-bold text-error leading-none tabular-nums">@CountBy(CtpatReviewStatus.ConCambios)</div>
                                <div class="text-[11px] text-base-content/40 leading-none">Con cambios</div>
                            </div>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <div class="w-2 h-2 rounded-full bg-success shrink-0"></div>
                            <div>
                                <div class="text-base font-bold text-success leading-none tabular-nums">@CountBy(CtpatReviewStatus.Revisado)</div>
                                <div class="text-[11px] text-base-content/40 leading-none">Revisado</div>
                            </div>
                        </div>
                    </div>

                </div>

                <!-- Divisor horizontal -->
                <div class="h-px bg-base-300"></div>

                <!-- Fila 2: Filtros -->
                <div class="flex flex-wrap items-end gap-2">
                    <fieldset class="fieldset py-0 flex-1 min-w-36 max-w-xs">
                        <legend class="fieldset-legend text-xs">Criterio</legend>
                        <select class="select select-bordered select-sm w-full"
                                @bind="_filterCriterio" @bind:after="StateHasChanged">
                            <option value="">Todos</option>
                            @foreach (var c in _criterios)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    </fieldset>
                    <fieldset class="fieldset py-0 min-w-32">
                        <legend class="fieldset-legend text-xs">Estado</legend>
                        <select class="select select-bordered select-sm w-full"
                                @bind="_filterStatus" @bind:after="StateHasChanged">
                            <option value="">Todos</option>
                            <option value="0">Pendiente</option>
                            <option value="1">Sin cambios</option>
                            <option value="2">Con cambios</option>
                            <option value="3">Revisado</option>
                        </select>
                    </fieldset>
                    <fieldset class="fieldset py-0 flex-1 min-w-40">
                        <legend class="fieldset-legend text-xs">Buscar</legend>
                        <input type="search" class="input input-bordered input-sm w-full"
                               placeholder="Pregunta, ID…"
                               @bind="_filterText" @bind:event="oninput" />
                    </fieldset>
                    <div class="text-xs text-base-content/40 self-end pb-1 whitespace-nowrap">
                        @Filtered.Count de @_questions.Count
                    </div>
                </div>

            </div>
        </div>

        <!-- Lista de preguntas agrupadas por criterio -->
        <div class="space-y-6">
        @foreach (var group in Filtered.GroupBy(q => q.Criterio).ToList())
        {
            var groupStats = GroupStats(group.Key);
            <div class="space-y-1">
                <!-- Cabecera del criterio -->
                <div class="flex items-center gap-2 px-1 pt-1 pb-2">
                    <span class="material-symbols-outlined text-[16px] text-base-content/40">folder</span>
                    <h2 class="text-sm font-semibold text-base-content/70">@group.Key</h2>
                    <div class="flex-1 h-px bg-base-300 mx-1"></div>
                    <span class="text-xs text-base-content/40">@groupStats.Atendidas/@groupStats.Total</span>
                    <div class="w-20 bg-base-300 rounded-full h-1.5">
                        <div class="@ProgressBarColor(groupStats.PctAvance) h-1.5 rounded-full transition-all duration-500"
                             style="width: @groupStats.PctAvance%"></div>
                    </div>
                    <span class="text-xs font-semibold @ProgressTextColor(groupStats.PctAvance)">@groupStats.PctAvance%</span>
                </div>

                @foreach (var q in group)
                {
                    var review = GetReview(q.Id);
                    var (dotCss, _, _) = StatusDot(review.Status);
                    var (badgeCls, badgeLabel) = StatusBadge(review.Status);
                    <div class="card bg-base-100 border border-base-300 hover:border-primary/40 hover:shadow-sm transition-all cursor-pointer"
                         @onclick="() => OpenPanel(q)">
                        <div class="card-body py-3 px-4 flex-row items-center gap-3">
                            <!-- Punto de estado -->
                            <div class="w-2.5 h-2.5 rounded-full shrink-0 @dotCss ring-2 ring-base-100"></div>

                            <div class="flex-1 min-w-0">
                                <div class="flex flex-wrap items-center gap-1 mb-1">
                                    <span class="badge badge-outline badge-sm font-mono text-xs">@q.ExternalId</span>
                                    <span class="badge @badgeCls badge-sm">@badgeLabel</span>
                                    @if (review.FechaRevision.HasValue)
                                    {
                                        <span class="badge badge-ghost badge-sm text-xs">
                                            <span class="material-symbols-outlined text-[12px] leading-none align-middle">calendar_today</span>
                                            @review.FechaRevision.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    @if (!string.IsNullOrEmpty(review.Revisor))
                                    {
                                        <span class="badge badge-ghost badge-sm text-xs">
                                            <span class="material-symbols-outlined text-[12px] leading-none align-middle">person</span>
                                            @review.Revisor
                                        </span>
                                    }
                                    @if (review.Files is { Count: > 0 })
                                    {
                                        <span class="badge badge-ghost badge-sm text-xs">
                                            <span class="material-symbols-outlined text-[12px] leading-none align-middle">attach_file</span>
                                            @review.Files.Count
                                        </span>
                                    }
                                </div>
                                <p class="text-sm text-base-content line-clamp-2">@q.Pregunta</p>
                            </div>

                            <span class="material-symbols-outlined text-[18px] text-base-content/30 shrink-0">chevron_right</span>
                        </div>
                    </div>
                }
            </div>
        }
        </div>
    }
</div>

@code {
    // ── State ────────────────────────────────────────────────────────────────
    private int _year = DateTime.Now.Year;
    private List<CtpatQuestion>? _questions;
    private IReadOnlyDictionary<int, CtpatReview> _reviewMap = new Dictionary<int, CtpatReview>();
    private List<string> _criterios = new();
    private string _filterCriterio = "";
    private string _filterStatus = "";
    private string _filterText = "";
    private string _currentUser = "anonymous";
    private bool _canEdit;
    private bool _isAdmin;

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        var user = await Session.GetCurrentAsync();
        _currentUser = user.DisplayName;
        _canEdit     = user.CanEdit;
        _isAdmin     = user.IsAdmin;

        // Registrar callbacks en el estado compartido del panel
        PanelState.OnSaveRequested       = SavePanel;
        PanelState.OnUploadFiles         = UploadFiles;
        PanelState.OnDeleteFileConfirmed = DeleteFileConfirmed;
        PanelState.OnRequestLogin        = () => LoginModal.Open();

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _questions  = (await Catalog.GetQuestionsAsync()).ToList();
        _criterios  = (await Catalog.GetCriteriosAsync()).ToList();
        _reviewMap  = await Reviews.GetReviewsForYearAsync(_year);
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 2020 && y <= 2100)
        {
            _year = y;
            await LoadDataAsync();
        }
    }

    // ── Panel open/close ─────────────────────────────────────────────────────
    private async Task OpenPanel(CtpatQuestion q)
    {
        // Asegurar que la revisión existe en DB antes de abrir el panel.
        // En modo solo-lectura NO creamos registros: mostramos un placeholder.
        CtpatReview review;
        if (_reviewMap.TryGetValue(q.Id, out var existing))
        {
            review = existing;
        }
        else if (_canEdit)
        {
            review = await Reviews.GetOrCreateAsync(q.Id, _year);
            var newMap = new Dictionary<int, CtpatReview>(_reviewMap) { [q.Id] = review };
            _reviewMap = newMap;
        }
        else
        {
            // Placeholder in-memory para poder abrir el panel en modo lectura.
            review = new CtpatReview
            {
                QuestionId = q.Id,
                Year       = _year,
                Status     = CtpatReviewStatus.Pendiente,
            };
        }

        var draft = new CtpatPanelDraft
        {
            Status            = review.Status,
            EvidenciaRevisada = review.EvidenciaRevisada,
            CambiosDetectados = review.CambiosDetectados,
            RespuestaNueva    = review.RespuestaNueva,
            Comentarios       = review.Comentarios,
            Revisor           = review.Revisor,
            FechaRevision     = review.FechaRevision,
        };

        PanelState.CurrentUser = _currentUser;
        PanelState.CanEdit     = _canEdit;
        PanelState.IsAdmin     = _isAdmin;
        PanelState.Open(q, review, draft);
        try { await JS.InvokeVoidAsync("cccPanel.lock"); } catch { }

        // Cargar guía de forma asíncrona
        _ = LoadGuidanceAsync(q.Criterio);
    }

    private async Task LoadGuidanceAsync(string criterio)
    {
        var groupName = criterio.Contains('.') ? criterio.Split('.')[0] : criterio;
        var guidance = await Catalog.GetGuidanceForGroupAsync(groupName);
        if (guidance.Count == 0)
            guidance = await Catalog.GetGuidanceForGroupAsync(criterio);

        PanelState.Guidance = guidance;
        PanelState.NotifyChanged();
    }

    // ── Save (invocado por CtpatSlidePanel a través del callback) ─────────────
    private async Task SavePanel()
    {
        if (!_canEdit) { LoginModal.Open(); return; }
        if (PanelState.Review is null) return;
        PanelState.Saving      = true;
        PanelState.SaveSuccess = false;
        PanelState.SaveError   = null;
        PanelState.NotifyChanged();

        try
        {
            var id    = PanelState.Review.Id;
            var draft = PanelState.Draft;
            await Reviews.UpdateStatusAsync(id, draft.Status, _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.EvidenciaRevisada), draft.EvidenciaRevisada, _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.CambiosDetectados), draft.CambiosDetectados, _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.RespuestaNueva),    draft.RespuestaNueva,    _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.Comentarios),       draft.Comentarios,       _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.Revisor),           draft.Revisor,           _currentUser);
            await Reviews.UpdateFieldAsync(id, nameof(CtpatReview.FechaRevision),
                draft.FechaRevision?.ToString("yyyy-MM-dd"), _currentUser);

            // Actualizar mapa y panel
            _reviewMap = await Reviews.GetReviewsForYearAsync(_year);
            PanelState.UpdateReview(_reviewMap[PanelState.Question!.Id]);

            PanelState.SaveSuccess = true;
            PanelState.NotifyChanged();
            await Task.Delay(2000);
            PanelState.SaveSuccess = false;
        }
        catch (Exception ex)
        {
            PanelState.SaveError = ex.Message;
        }
        finally
        {
            PanelState.Saving = false;
            PanelState.NotifyChanged();
            await InvokeAsync(StateHasChanged); // actualizar la lista de preguntas
        }
    }

    // ── File upload ──────────────────────────────────────────────────────────
    private async Task UploadFiles(IReadOnlyList<IBrowserFile> files)
    {
        if (!_canEdit) { LoginModal.Open(); return; }
        if (PanelState.Review is null) return;
        PanelState.UploadError = null;

        foreach (var file in files)
        {
            if (file.Size > 25 * 1024 * 1024)
            {
                PanelState.UploadError = $"{file.Name} supera el límite de 25 MB.";
                PanelState.NotifyChanged();
                continue;
            }

            PanelState.UploadingFiles.Add(file);
            PanelState.NotifyChanged();

            try
            {
                using var stream = file.OpenReadStream(25 * 1024 * 1024);
                await FileService.UploadAsync(
                    PanelState.Review.Id, file.Name, file.ContentType, stream, _currentUser);
            }
            catch (Exception ex)
            {
                PanelState.UploadError = $"Error al subir {file.Name}: {ex.Message}";
            }
            finally
            {
                PanelState.UploadingFiles.Remove(file);
            }
        }

        // Refrescar mapa y revisión del panel
        _reviewMap = await Reviews.GetReviewsForYearAsync(_year);
        var updated = _reviewMap.GetValueOrDefault(PanelState.Question!.Id) ?? PanelState.Review;
        PanelState.UpdateReview(updated);
    }

    // ── File delete ──────────────────────────────────────────────────────────
    private async Task DeleteFileConfirmed()
    {
        if (!_canEdit) { LoginModal.Open(); return; }
        if (PanelState.FileToDelete is null) return;
        PanelState.DeletingFile = true;
        PanelState.NotifyChanged();

        try
        {
            await FileService.DeleteAsync(PanelState.FileToDelete.Value.Id);
            _reviewMap = await Reviews.GetReviewsForYearAsync(_year);
            var updated = _reviewMap.GetValueOrDefault(PanelState.Question!.Id) ?? PanelState.Review!;
            PanelState.UpdateReview(updated);
        }
        finally
        {
            PanelState.DeletingFile  = false;
            PanelState.FileToDelete  = null;
            PanelState.NotifyChanged();
        }
    }

    // ── Helpers ──────────────────────────────────────────────────────────────
    private CtpatReview GetReview(int questionId)
    {
        if (_reviewMap.TryGetValue(questionId, out var r)) return r;
        return new CtpatReview { QuestionId = questionId, Year = _year, Status = CtpatReviewStatus.Pendiente };
    }

    private List<CtpatQuestion> Filtered
    {
        get
        {
            if (_questions is null) return new();
            IEnumerable<CtpatQuestion> q = _questions;
            if (!string.IsNullOrEmpty(_filterCriterio)) q = q.Where(x => x.Criterio == _filterCriterio);
            if (!string.IsNullOrEmpty(_filterStatus) && int.TryParse(_filterStatus, out var s))
                q = q.Where(x => (int)GetReview(x.Id).Status == s);
            if (!string.IsNullOrWhiteSpace(_filterText))
            {
                var t = _filterText.Trim().ToLowerInvariant();
                q = q.Where(x =>
                    x.Pregunta.ToLowerInvariant().Contains(t) ||
                    (x.Respuesta2025 ?? "").ToLowerInvariant().Contains(t) ||
                    x.ExternalId.ToLowerInvariant().Contains(t));
            }
            return q.ToList();
        }
    }

    private CtpatCriterioStats GroupStats(string criterio)
    {
        if (_questions is null) return new(criterio, 0, 0, 0, 0, 0);
        var qs = _questions.Where(q => q.Criterio == criterio).ToList();
        return new CtpatCriterioStats(
            criterio,
            qs.Count,
            qs.Count(q => GetReview(q.Id).Status == CtpatReviewStatus.Pendiente),
            qs.Count(q => GetReview(q.Id).Status == CtpatReviewStatus.SinCambios),
            qs.Count(q => GetReview(q.Id).Status == CtpatReviewStatus.ConCambios),
            qs.Count(q => GetReview(q.Id).Status == CtpatReviewStatus.Revisado));
    }

    private int Atendidas => _questions is null ? 0 : _questions.Count(x => GetReview(x.Id).Status != CtpatReviewStatus.Pendiente);
    private int Progress  => (_questions is null || _questions.Count == 0) ? 0 : (int)Math.Round(Atendidas * 100.0 / _questions.Count);
    private int CountBy(CtpatReviewStatus s) => _questions?.Count(x => GetReview(x.Id).Status == s) ?? 0;

    private static (string cssClass, string label) StatusBadge(CtpatReviewStatus s) => s switch
    {
        CtpatReviewStatus.Pendiente  => ("badge-warning",  "Pendiente"),
        CtpatReviewStatus.SinCambios => ("badge-info",     "Sin cambios"),
        CtpatReviewStatus.ConCambios => ("badge-error",    "Con cambios"),
        CtpatReviewStatus.Revisado   => ("badge-success",  "Revisado"),
        _ => ("badge-ghost", s.ToString())
    };

    private static (string dot, string strip, string text) StatusDot(CtpatReviewStatus s) => s switch
    {
        CtpatReviewStatus.Pendiente  => ("bg-warning",  "bg-warning",  "text-warning"),
        CtpatReviewStatus.SinCambios => ("bg-info",     "bg-info",     "text-info"),
        CtpatReviewStatus.ConCambios => ("bg-error",    "bg-error",    "text-error"),
        CtpatReviewStatus.Revisado   => ("bg-success",  "bg-success",  "text-success"),
        _ => ("bg-base-300", "bg-base-300", "text-base-content")
    };

    private static string StatusStrip(CtpatReviewStatus s) => s switch
    {
        CtpatReviewStatus.Pendiente  => "bg-warning",
        CtpatReviewStatus.SinCambios => "bg-info",
        CtpatReviewStatus.ConCambios => "bg-error",
        CtpatReviewStatus.Revisado   => "bg-success",
        _ => "bg-base-300"
    };

    private static string ProgressBarColor(int pct) => pct switch
    {
        >= 100 => "bg-success",
        >= 60  => "bg-primary",
        >= 30  => "bg-warning",
        _      => "bg-error"
    };

    private static string ProgressTextColor(int pct) => pct switch
    {
        >= 100 => "text-success",
        >= 60  => "text-primary",
        >= 30  => "text-warning",
        _      => "text-error"
    };
}
