@* Menú desplegable de estado controlado desde Blazor (sin details/summary).
   Evita la race condition entre onfocusout y onclick que existía con el
   elemento <details> nativo: el click cerraba el dropdown antes de que
   el evento onclick del botón de opción llegara a invocarse.

   El popup usa `position: fixed` con coordenadas calculadas por JS
   (`cccFixedPopover`) para escapar de contenedores con overflow (como el
   scroll horizontal de la tabla del Checklist). *@

@inject IJSRuntime JS

<div class="inline-block">
    <button type="button"
            class="cursor-pointer"
            disabled="@Disabled"
            @onclick="ToggleAsync"
            @onclick:stopPropagation
            @ref="_triggerRef">
        <StatusBadge Status="@Current" />
    </button>

    @if (_open)
    {
        <!-- Backdrop invisible para cerrar al click fuera -->
        <div class="fixed inset-0 z-40" @onclick="CloseAsync" @onclick:stopPropagation></div>

        <ul class="fixed menu bg-base-100 rounded-box z-50 w-44 p-2 shadow-lg border border-base-300 dropdown-in"
            style="top:@(_top)px; left:@(_left)px;">
            @foreach (var status in AllStatuses)
            {
                var s = status;
                <li>
                    <button type="button"
                            class="justify-between rounded-md"
                            @onclick="() => SelectAsync(s)"
                            @onclick:stopPropagation>
                        <StatusBadge Status="@s" />
                        @if (s == Current)
                        {
                            <span class="text-primary">
                                <span class="material-symbols-outlined text-[16px] leading-none">check</span>
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public ComplianceStatus Current { get; set; }
    [Parameter, EditorRequired] public EventCallback<ComplianceStatus> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _open;
    private ElementReference _triggerRef;

    // Coordenadas calculadas para position: fixed
    private double _top;
    private double _left;

    // Dimensiones estimadas del popup (deben coincidir con las clases w-44 y ~5 items)
    private const int PopoverWidthPx  = 176;  // w-44
    private const int PopoverHeightPx = 220;  // 5 opciones × ~40px + padding

    private static readonly ComplianceStatus[] AllStatuses =
    [
        ComplianceStatus.Pendiente,
        ComplianceStatus.EnProgreso,
        ComplianceStatus.Completado,
        ComplianceStatus.Vencido,
        ComplianceStatus.NA,
    ];

    private async Task ToggleAsync()
    {
        if (Disabled) return;
        _open = !_open;
        if (_open) await MeasurePlacementAsync();
    }

    private async Task MeasurePlacementAsync()
    {
        try
        {
            var r = await JS.InvokeAsync<Placement>(
                "cccFixedPopover.getPlacement",
                _triggerRef, PopoverHeightPx, PopoverWidthPx, "start");
            _top  = r.Top;
            _left = r.Left;
        }
        catch
        {
            _top  = 0;
            _left = 0;
        }
    }

    private void CloseAsync() => _open = false;

    private async Task SelectAsync(ComplianceStatus s)
    {
        _open = false;
        if (s == Current) return;
        await OnChange.InvokeAsync(s);
    }

    private record Placement(double Top, double Left, bool OpenUp, bool OpenLeft);
}
