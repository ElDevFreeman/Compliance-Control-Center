@* Menú desplegable de estado controlado desde Blazor (sin details/summary).
   Evita la race condition entre onfocusout y onclick que existía con el
   elemento <details> nativo: el click cerraba el dropdown antes de que
   el evento onclick del botón de opción llegara a invocarse.

   El popup usa `position: fixed` con coordenadas calculadas por JS
   (`cccFixedPopover.measureAndPlace`) para escapar de contenedores con
   overflow (como el scroll horizontal de la tabla del Checklist).
   Se renderiza primero con visibility:hidden para poder medir su tamaño
   REAL antes de posicionarlo, evitando desplazamientos por estimaciones
   incorrectas. *@

@inject IJSRuntime JS

<div class="inline-block">
    <button type="button"
            class="cursor-pointer"
            disabled="@Disabled"
            @onclick="ToggleAsync"
            @onclick:stopPropagation
            @ref="_triggerRef">
        <StatusBadge Status="@Current" />
    </button>

    @if (_open)
    {
        <!-- Backdrop invisible para cerrar al click fuera -->
        <div class="fixed inset-0 z-40" @onclick="CloseAsync" @onclick:stopPropagation></div>

        <ul @ref="_popoverRef"
            class="fixed menu bg-base-100 rounded-box z-50 w-44 p-2 shadow-lg border border-base-300 dropdown-in"
            style="top:@(_top)px; left:@(_left)px; @(_measured ? "" : "visibility:hidden;")">
            @foreach (var status in AllStatuses)
            {
                var s = status;
                <li>
                    <button type="button"
                            class="justify-between rounded-md"
                            @onclick="() => SelectAsync(s)"
                            @onclick:stopPropagation>
                        <StatusBadge Status="@s" />
                        @if (s == Current)
                        {
                            <span class="text-primary">
                                <span class="material-symbols-outlined text-[16px] leading-none">check</span>
                            </span>
                        }
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter, EditorRequired] public ComplianceStatus Current { get; set; }
    [Parameter, EditorRequired] public EventCallback<ComplianceStatus> OnChange { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private bool _open;
    private bool _measured;
    private ElementReference _triggerRef;
    private ElementReference _popoverRef;

    // Coordenadas calculadas para position: fixed
    private double _top;
    private double _left;

    private static readonly ComplianceStatus[] AllStatuses =
    [
        ComplianceStatus.Pendiente,
        ComplianceStatus.EnProgreso,
        ComplianceStatus.Completado,
        ComplianceStatus.Vencido,
        ComplianceStatus.NA,
    ];

    private Task ToggleAsync()
    {
        if (Disabled) return Task.CompletedTask;
        if (_open)
        {
            _open = false;
            _measured = false;
        }
        else
        {
            // Reset: se abre invisible; OnAfterRenderAsync mide y posiciona.
            _measured = false;
            _top = 0;
            _left = 0;
            _open = true;
        }
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Cuando el popover acaba de renderizarse (invisible), lo medimos y
        // aplicamos coordenadas. Un solo StateHasChanged final lo hace visible.
        if (_open && !_measured)
        {
            try
            {
                var r = await JS.InvokeAsync<Placement>(
                    "cccFixedPopover.measureAndPlace",
                    _popoverRef, _triggerRef, "center", "bottom");
                _top  = r.Top;
                _left = r.Left;
            }
            catch
            {
                _top  = 0;
                _left = 0;
            }
            _measured = true;
            StateHasChanged();
        }
    }

    private void CloseAsync()
    {
        _open = false;
        _measured = false;
    }

    private async Task SelectAsync(ComplianceStatus s)
    {
        _open = false;
        _measured = false;
        if (s == Current) return;
        await OnChange.InvokeAsync(s);
    }

    private record Placement(double Top, double Left, bool OpenUp, bool OpenLeft);
}
