@page "/oea/matrix"
@page "/oea/history"
@rendermode InteractiveServer
@implements IDisposable
@inject IMatrixService MatrixSvc
@inject IChecklistService ChecklistSvc
@inject IAuditService AuditSvc
@inject NavigationManager Nav
@inject ThemeState Theme

<PageTitle>Matriz &amp; Auditoría</PageTitle>

<div class="flex flex-wrap items-end justify-between gap-3 mb-4">
    <div>
        <h1 class="text-2xl font-bold text-base-content">Matriz &amp; Auditoría</h1>
        <p class="text-sm text-base-content/60">Cumplimiento mensual y registro de eventos del sistema</p>
    </div>
</div>

<!-- ── Tabs principal ─────────────────────────────────────────── -->
<div role="tablist" class="tabs tabs-border mb-4">
    <button role="tab"
            class="tab smooth @(_activeTab == "matrix" ? "tab-active" : "")"
            @onclick='() => SetTab("matrix")'>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
        </svg>
        Matriz mensual
    </button>
    <button role="tab"
            class="tab smooth @(_activeTab == "audit" ? "tab-active" : "")"
            @onclick='() => SetTab("audit")'>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Auditoría
        @if (_logs is not null)
        {
            <span class="badge badge-ghost badge-sm ml-2">@_logs.Count</span>
        }
    </button>
</div>

@if (_activeTab == "matrix")
{
    <!-- ── Toolbar Matriz ─────────────────────────────────────── -->
    <div class="card card-border bg-base-100 border-base-300 mb-3 fade-in-fast">
        <div class="card-body p-3">
            <div class="flex flex-wrap gap-3 items-end">
                <fieldset class="fieldset">
                    <legend class="fieldset-legend">Rango</legend>
                    <select class="select select-bordered select-sm"
                            @bind="_range" @bind:after="OnRangeChangedAsync">
                        <option value="6">Últimos 6 meses</option>
                        <option value="12">Últimos 12 meses</option>
                        <option value="year">Este año</option>
                        <option value="custom">Personalizado</option>
                    </select>
                </fieldset>

                @if (_range == "custom")
                {
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">Desde</legend>
                        <MonthPicker Value="@FromValue" ValueChanged="OnFromChanged" />
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="fieldset-legend">Hasta</legend>
                        <MonthPicker Value="@ToValue" ValueChanged="OnToChanged" Align="end" />
                    </fieldset>
                }

                <fieldset class="fieldset">
                    <legend class="fieldset-legend">Responsable</legend>
                    <select class="select select-bordered select-sm"
                            @bind="_owner" @bind:after="LoadAsync">
                        <option value="">Todos</option>
                        @foreach (var o in _availableOwners)
                        {
                            <option value="@o">@o</option>
                        }
                    </select>
                </fieldset>

                <fieldset class="fieldset flex-1 min-w-[220px]">
                    <legend class="fieldset-legend">Buscar</legend>
                    <label class="input input-bordered input-sm w-full flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-60" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" class="grow" placeholder="Filtrar actividad..."
                               @bind="_search" @bind:event="oninput" @bind:after="LoadAsync" />
                    </label>
                </fieldset>

                <a href="@ExportUrl" class="btn btn-sm btn-outline" target="_blank" title="Exportar Excel">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3" />
                    </svg>
                    XLSX
                </a>
            </div>
        </div>
    </div>

    <!-- ── KPIs + Sparkline compacta ─────────────────────────── -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
        <KpiCard Label="Actividades" Value="@_rows.Count.ToString()" Variant="neutral"
                 IconPath="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        <KpiCard Label="Meses en rango" Value="@_months.Count.ToString()" Variant="info"
                 IconPath="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        <KpiCard Label="% Global cumplimiento" Value="@($"{GlobalPct}%")" Variant="success"
                 IconPath="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />

        <!-- Sparkline compacta como 4ta tarjeta -->
        <div class="card card-border bg-base-100 border-base-300">
            <div class="card-body p-4 gap-1">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-base-content/60 uppercase tracking-wider">
                        Tendencia
                    </span>
                    @if (_chartData.Count > 0)
                    {
                        <span class="text-xs font-semibold @PctClass(_chartData[^1].Pct)">
                            @($"{_chartData[^1].Pct:0.#}%")
                        </span>
                    }
                </div>
                @if (_months.Count > 0 && _rows.Count > 0)
                {
                    <div class="h-14 -mx-1">
                        <ApexChart TItem="MonthlyPct"
                                   Options="_chartOptions"
                                   @ref="_chart">
                            <ApexPointSeries TItem="MonthlyPct"
                                             Items="_chartData"
                                             Name="% Cumplimiento"
                                             SeriesType="SeriesType.Area"
                                             XValue="e => e.Label"
                                             YValue="e => (decimal)e.Pct" />
                        </ApexChart>
                    </div>
                }
                else
                {
                    <div class="h-14 flex items-center justify-center text-xs text-base-content/40">
                        Sin datos
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ── Tabla pivotada ────────────────────────────────────── -->
    <div class="rounded-box border border-base-content/5 bg-base-100 overflow-hidden">
        @if (_loading)
        {
            <TableSkeleton Rows="10" Columns="8" />
        }
        else if (_rows.Count == 0)
        {
            <div class="text-center py-16 text-base-content/60">Sin datos en el rango seleccionado.</div>
        }
        else
        {
            <div class="overflow-auto max-h-[60vh]">
                <table class="table table-sm table-pin-rows table-pin-cols">
                    <thead>
                        <tr class="bg-base-200 text-base-content/70">
                            <th class="w-32">Item</th>
                            <th class="min-w-[240px]">Actividad</th>
                            <th class="w-32">Responsable</th>
                            @foreach (var m in _months)
                            {
                                <th class="text-center whitespace-nowrap w-20">@MonthLabel(m)</th>
                            }
                            <th class="text-center w-20">%</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in PagedRows)
                        {
                            <tr class="hover:bg-base-200/50">
                                <td class="font-mono text-xs text-primary font-semibold">@row.Item</td>
                                <td class="text-sm">@row.Name</td>
                                <td class="text-sm">@row.Owner</td>
                                @foreach (var m in _months)
                                {
                                    var st = row.Statuses.TryGetValue(m, out var s) ? s : null;
                                    <td class="text-center px-1">
                                        @if (st is null)
                                        {
                                            <span class="text-base-content/20">—</span>
                                        }
                                        else
                                        {
                                            <StatusBadge Status="@st.Value" Extra="badge-sm" />
                                        }
                                    </td>
                                }
                                <td class="text-center font-bold @PctClass(row.CompliancePct)">
                                    @($"{row.CompliancePct:0.#}%")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager TotalItems="_rows.Count"
                   CurrentPage="_page"
                   PageSize="_pageSize"
                   CurrentPageChanged="p => _page = p"
                   PageSizeChanged="s => _pageSize = s" />
        }
    </div>
}
else
{
    <!-- ── Auditoría ──────────────────────────────────────────── -->
    <div class="card card-border bg-base-100 border-base-300 mb-3 fade-in-fast">
        <div class="card-body p-3">
            <div class="flex flex-wrap gap-3 items-end">
                <fieldset class="fieldset flex-1 min-w-[220px]">
                    <legend class="fieldset-legend">Buscar</legend>
                    <label class="input input-bordered input-sm w-full flex items-center gap-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-60" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" class="grow" placeholder="Filtrar por usuario, acción o entidad..."
                               @bind="_auditSearch" @bind:event="oninput" />
                    </label>
                </fieldset>

                <fieldset class="fieldset">
                    <legend class="fieldset-legend">Acción</legend>
                    <select class="select select-bordered select-sm" @bind="_auditAction">
                        <option value="">Todas</option>
                        @foreach (var a in _availableActions)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </fieldset>

                <button class="btn btn-sm btn-outline" @onclick="RefreshAuditAsync" title="Refrescar">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                         viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                    </svg>
                    Refrescar
                </button>
            </div>
        </div>
    </div>

    <div class="rounded-box border border-base-content/5 bg-base-100 overflow-hidden">
        @if (_logs is null)
        {
            <TableSkeleton Rows="8" Columns="5" />
        }
        else if (FilteredLogs.Count == 0)
        {
            <div class="text-center py-16 text-base-content/60">
                @(_logs.Count == 0 ? "Sin eventos registrados aún." : "Ningún evento coincide con el filtro.")
            </div>
        }
        else
        {
            <div class="overflow-auto max-h-[60vh]">
                <table class="table table-sm table-zebra table-pin-rows">
                    <thead>
                        <tr class="bg-base-200 text-base-content/70">
                            <th class="w-44">Fecha</th>
                            <th class="w-40">Usuario</th>
                            <th class="w-32">Acción</th>
                            <th>Entidad</th>
                            <th class="w-32">Id</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in PagedLogs)
                        {
                            <tr class="hover:bg-base-200/50">
                                <td class="whitespace-nowrap font-mono text-xs">
                                    @log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                </td>
                                <td class="text-sm">@log.User</td>
                                <td>
                                    <span class="badge badge-soft @ActionBadgeClass(log.Action) badge-sm">
                                        @log.Action
                                    </span>
                                </td>
                                <td class="text-sm">@log.EntityName</td>
                                <td class="font-mono text-xs text-base-content/60">@log.EntityId</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pager TotalItems="FilteredLogs.Count"
                   CurrentPage="_auditPage"
                   PageSize="_auditPageSize"
                   CurrentPageChanged="p => _auditPage = p"
                   PageSizeChanged="s => _auditPageSize = s" />
        }
    </div>
}

@code {
    // ── Estado de tabs ────────────────────────────────────────
    private string _activeTab = "matrix";

    // ── Matriz ────────────────────────────────────────────────
    private string _range = "12";
    private DateTime _from = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddMonths(-11);
    private DateTime _to = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private string _owner = "";
    private string _search = "";

    private List<MatrixRow> _rows = new();
    private List<(int Year, int Month)> _months = new();
    private List<string> _availableOwners = new();
    private bool _loading = true;

    private int _page = 1;
    private int _pageSize = 25;

    private IEnumerable<MatrixRow> PagedRows
    {
        get
        {
            var totalPages = _pageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)_rows.Count / _pageSize));
            if (_page > totalPages) _page = totalPages;
            if (_page < 1) _page = 1;
            return _rows.Skip((_page - 1) * _pageSize).Take(_pageSize);
        }
    }

    private ApexChart<MonthlyPct>? _chart;
    private List<MonthlyPct> _chartData = new();
    private ApexChartOptions<MonthlyPct> _chartOptions = new();

    private string FromValue => _from.ToString("yyyy-MM");
    private string ToValue => _to.ToString("yyyy-MM");

    private string ExportUrl
    {
        get
        {
            var qs = new List<string>
            {
                $"fromYear={_from.Year}",
                $"fromMonth={_from.Month}",
                $"toYear={_to.Year}",
                $"toMonth={_to.Month}"
            };
            if (!string.IsNullOrEmpty(_owner)) qs.Add($"owner={Uri.EscapeDataString(_owner)}");
            if (!string.IsNullOrEmpty(_search)) qs.Add($"search={Uri.EscapeDataString(_search)}");
            return "/api/export/matrix.xlsx?" + string.Join("&", qs);
        }
    }

    private int GlobalPct
    {
        get
        {
            if (_rows.Count == 0) return 0;
            var totalRated = _rows.Sum(r => r.TotalRated);
            var totalCompleted = _rows.Sum(r => r.Completed);
            return totalRated == 0 ? 0 : (int)Math.Round(100.0 * totalCompleted / totalRated);
        }
    }

    // ── Auditoría ─────────────────────────────────────────────
    private List<AuditLog>? _logs;
    private string _auditSearch = "";
    private string _auditAction = "";
    private int _auditPage = 1;
    private int _auditPageSize = 25;

    private List<string> _availableActions = new();

    private List<AuditLog> FilteredLogs
    {
        get
        {
            if (_logs is null) return new();
            IEnumerable<AuditLog> q = _logs;
            if (!string.IsNullOrWhiteSpace(_auditAction))
                q = q.Where(l => string.Equals(l.Action, _auditAction, StringComparison.OrdinalIgnoreCase));
            if (!string.IsNullOrWhiteSpace(_auditSearch))
            {
                var s = _auditSearch.Trim();
                q = q.Where(l =>
                    (l.User ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.Action ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.EntityName ?? "").Contains(s, StringComparison.OrdinalIgnoreCase) ||
                    (l.EntityId ?? "").Contains(s, StringComparison.OrdinalIgnoreCase));
            }
            return q.ToList();
        }
    }

    private IEnumerable<AuditLog> PagedLogs
    {
        get
        {
            var filtered = FilteredLogs;
            var totalPages = _auditPageSize <= 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)filtered.Count / _auditPageSize));
            if (_auditPage > totalPages) _auditPage = totalPages;
            if (_auditPage < 1) _auditPage = 1;
            return filtered.Skip((_auditPage - 1) * _auditPageSize).Take(_auditPageSize);
        }
    }

    // ── Ciclo de vida ─────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        // Si el usuario entra por /history, activar tab de auditoría.
        var uri = new Uri(Nav.Uri);
        if (uri.AbsolutePath.TrimEnd('/').EndsWith("/history", StringComparison.OrdinalIgnoreCase))
        {
            _activeTab = "audit";
        }

        BuildChartOptions();
        Theme.OnChange += OnThemeChanged;
        ApplyRange();
        await LoadAvailableOwnersAsync();
        await LoadAsync();
        await LoadAuditAsync();
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
    }

    private void BuildChartOptions()
    {
        _chartOptions = new ApexChartOptions<MonthlyPct>
        {
            Chart = new Chart
            {
                Toolbar = new Toolbar { Show = false },
                Zoom = new Zoom { Enabled = false },
                Sparkline = new ChartSparkline { Enabled = true },
                Background = "transparent",
                Height = 56
            },
            Theme = new ApexCharts.Theme
            {
                Mode = Theme.IsDark ? Mode.Dark : Mode.Light
            },
            Stroke = new Stroke { Curve = Curve.Smooth, Width = 2 },
            Tooltip = new Tooltip { Enabled = true },
            Yaxis = new List<YAxis>
            {
                new YAxis { Min = 0, Max = 100, Show = false }
            }
        };
    }

    private async void OnThemeChanged()
    {
        BuildChartOptions();
        if (_chart is not null)
        {
            try { await _chart.UpdateOptionsAsync(false, true, false); } catch { }
        }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => Theme.OnChange -= OnThemeChanged;

    // ── Handlers Matriz ───────────────────────────────────────
    private async Task OnRangeChangedAsync()
    {
        ApplyRange();
        await LoadAsync();
    }

    private void ApplyRange()
    {
        var today = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
        switch (_range)
        {
            case "6":    _from = today.AddMonths(-5); _to = today; break;
            case "12":   _from = today.AddMonths(-11); _to = today; break;
            case "year": _from = new DateTime(today.Year, 1, 1); _to = today; break;
        }
    }

    private async Task OnFromChanged(string? v)
    {
        if (!string.IsNullOrEmpty(v) && DateTime.TryParse(v + "-01", out var d))
        {
            _from = d;
            await LoadAsync();
        }
    }

    private async Task OnToChanged(string? v)
    {
        if (!string.IsNullOrEmpty(v) && DateTime.TryParse(v + "-01", out var d))
        {
            _to = d;
            await LoadAsync();
        }
    }

    private async Task LoadAvailableOwnersAsync()
    {
        var activities = await ChecklistSvc.GetActivitiesForMonthAsync(_to.Year, _to.Month);
        _availableOwners = activities
            .Select(a => a.Owner)
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .Distinct()
            .OrderBy(o => o)
            .ToList();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _page = 1;
        StateHasChanged();

        var result = await MatrixSvc.GetMatrixAsync(
            _from.Year, _from.Month,
            _to.Year, _to.Month,
            owner: string.IsNullOrEmpty(_owner) ? null : _owner,
            search: string.IsNullOrEmpty(_search) ? null : _search
        );

        _rows = result.Rows.ToList();
        _months = result.Months.ToList();
        _chartData = BuildChartData();
        _loading = false;

        if (_chart is not null)
        {
            try { await _chart.UpdateSeriesAsync(); } catch { }
        }
        StateHasChanged();
    }

    private List<MonthlyPct> BuildChartData()
    {
        var data = new List<MonthlyPct>();
        foreach (var m in _months)
        {
            var completed = _rows.Count(r => r.Statuses.TryGetValue(m, out var s) && s == ComplianceStatus.Completado);
            var rated = _rows.Count(r => r.Statuses.TryGetValue(m, out var s) && s is not null && s != ComplianceStatus.NA);
            var pct = rated == 0 ? 0 : Math.Round(100.0 * completed / rated, 1);
            data.Add(new MonthlyPct(MonthLabel(m), pct, completed));
        }
        return data;
    }

    private static string MonthLabel((int Year, int Month) m)
    {
        var names = new[] { "Ene", "Feb", "Mar", "Abr", "May", "Jun", "Jul", "Ago", "Sep", "Oct", "Nov", "Dic" };
        return $"{names[m.Month - 1]} {m.Year % 100:00}";
    }

    private static string PctClass(double pct) => pct switch
    {
        >= 80 => "text-success",
        >= 50 => "text-warning",
        > 0   => "text-error",
        _     => "text-base-content/40"
    };

    // ── Handlers Auditoría ────────────────────────────────────
    private async Task LoadAuditAsync()
    {
        _logs = (await AuditSvc.GetRecentAsync(500)).ToList();
        _availableActions = _logs
            .Select(l => l.Action)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct()
            .OrderBy(a => a)
            .ToList();
    }

    private async Task RefreshAuditAsync()
    {
        _logs = null;
        StateHasChanged();
        await LoadAuditAsync();
    }

    private static string ActionBadgeClass(string action)
    {
        var a = action?.ToLowerInvariant() ?? "";
        if (a.Contains("delete") || a.Contains("elimin")) return "badge-error";
        if (a.Contains("create") || a.Contains("add") || a.Contains("crear")) return "badge-success";
        if (a.Contains("update") || a.Contains("edit") || a.Contains("actualiz")) return "badge-info";
        return "badge-ghost";
    }

    public record MonthlyPct(string Label, double Pct, int Completed);
}
