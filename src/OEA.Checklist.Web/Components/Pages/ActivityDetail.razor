@page "/activity/{Id:int}"
@rendermode InteractiveServer
@inject IChecklistService ChecklistSvc
@inject ICommentService CommentSvc
@inject UserSessionState Session
@inject NavigationManager Nav

<PageTitle>@(_activity?.Item ?? "Actividad")</PageTitle>

@if (_loading)
{
    <!-- Skeleton principal: cabecera + 2 tarjetas + comentarios -->
    <div class="space-y-4">
        <div class="flex items-center gap-3">
            <div class="skeleton h-8 w-24"></div>
            <div class="flex-1 space-y-2">
                <div class="skeleton h-6 w-2/3"></div>
                <div class="skeleton h-3 w-1/3"></div>
            </div>
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2 space-y-4">
                <div class="card card-border bg-base-100 border-base-300">
                    <div class="card-body p-4 space-y-3">
                        <div class="skeleton h-3 w-32"></div>
                        <div class="skeleton h-4 w-full"></div>
                        <div class="skeleton h-4 w-5/6"></div>
                        <div class="skeleton h-4 w-4/6"></div>
                        <div class="skeleton h-4 w-3/6"></div>
                    </div>
                </div>
                <div class="card card-border bg-base-100 border-base-300">
                    <div class="card-body p-4">
                        <div class="skeleton h-3 w-40 mb-3"></div>
                        <TableSkeleton Rows="6" Columns="4" ShowHeader="true" />
                    </div>
                </div>
            </div>
            <div class="space-y-4">
                <div class="card card-border bg-base-100 border-base-300">
                    <div class="card-body p-4 space-y-3">
                        <div class="skeleton h-3 w-32"></div>
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="flex gap-3 items-start">
                                <div class="skeleton h-8 w-8 rounded-full shrink-0"></div>
                                <div class="flex-1 space-y-2">
                                    <div class="skeleton h-3 w-1/3"></div>
                                    <div class="skeleton h-12 w-full"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else if (_activity is null)
{
    <div class="alert alert-error alert-soft fade-in">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z" />
        </svg>
        <span>Actividad no encontrada.</span>
    </div>
    <a href="/" class="btn btn-primary mt-4">← Volver</a>
}
else
{
    <div class="flex items-center gap-3 mb-4 fade-in">
        <a href="/" class="btn btn-ghost btn-sm smooth">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none"
                 viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
            Checklist
        </a>
        <div>
            <h1 class="text-2xl font-bold flex items-center gap-2 text-base-content">
                <span class="font-mono text-primary text-lg">@_activity.Item</span>
                <span class="text-base-content/30">·</span>
                <span>@_activity.Name</span>
            </h1>
            <p class="text-sm text-base-content/60">@_activity.Legal</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <!-- ── Columna izquierda: datos + historial ─────────────── -->
        <div class="lg:col-span-2 space-y-4">
            <!-- Datos generales -->
            <div class="card card-border bg-base-100 border-base-300 fade-in">
                <div class="card-body p-4">
                    <h3 class="text-sm uppercase tracking-wider text-base-content/60 font-semibold mb-2">
                        Datos generales
                    </h3>
                    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-x-4 gap-y-2 text-sm">
                        <dt class="font-semibold text-base-content/70">Descripción</dt>
                        <dd class="sm:col-span-2">@Or(_activity.Description)</dd>

                        <dt class="font-semibold text-base-content/70">Documentos</dt>
                        <dd class="sm:col-span-2">@Or(_activity.Documents)</dd>

                        <dt class="font-semibold text-base-content/70">Responsable</dt>
                        <dd class="sm:col-span-2">@Or(_activity.Owner)</dd>

                        <dt class="font-semibold text-base-content/70">Relacionados</dt>
                        <dd class="sm:col-span-2">@Or(_activity.Related)</dd>

                        <dt class="font-semibold text-base-content/70">Frecuencia</dt>
                        <dd class="sm:col-span-2">@Or(_activity.Frequency)</dd>
                    </dl>
                </div>
            </div>

            <!-- Historial mensual -->
            <div class="card card-border bg-base-100 border-base-300 fade-in">
                <div class="card-body p-4">
                    <h3 class="text-sm uppercase tracking-wider text-base-content/60 font-semibold mb-2">
                        Historial (últimos 12 meses)
                    </h3>
                    @if (_history.Count == 0)
                    {
                        <p class="text-base-content/50 text-sm">Sin historial aún.</p>
                    }
                    else
                    {
                        <div class="overflow-auto max-h-96 rounded-box border border-base-content/5 bg-base-100">
                            <table class="table table-sm table-zebra table-pin-rows">
                                <thead>
                                    <tr class="bg-base-200 text-base-content/70">
                                        <th>Mes</th>
                                        <th>Estado</th>
                                        <th>Vencimiento</th>
                                        <th>Actualizado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in _history)
                                    {
                                        <tr class="hover:bg-base-200/50 smooth">
                                            <td class="font-mono">@($"{m.Year:0000}-{m.Month:00}")</td>
                                            <td><StatusBadge Status="@m.Status" /></td>
                                            <td>@(m.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                                            <td class="text-xs text-base-content/60">
                                                @m.UpdatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                                @if (!string.IsNullOrEmpty(m.UpdatedBy))
                                                {
                                                    <span> · @m.UpdatedBy</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- ── Columna derecha: comentarios (chat daisyUI) ──────── -->
        <div class="space-y-4">
            <div class="card card-border bg-base-100 border-base-300 fade-in">
                <div class="card-body p-4">
                    <h3 class="text-sm uppercase tracking-wider text-base-content/60 font-semibold mb-2">
                        Comentarios (@_comments.Count)
                    </h3>

                    @if (_user.IsAuthenticated)
                    {
                        <fieldset class="fieldset">
                            <legend class="fieldset-legend">Nuevo comentario</legend>
                            <textarea class="textarea textarea-bordered textarea-sm w-full smooth"
                                      rows="3"
                                      placeholder="Escribe un comentario..."
                                      @bind="_newComment"></textarea>
                        </fieldset>
                        <button class="btn btn-primary btn-sm mt-2 w-full smooth"
                                @onclick="AddCommentAsync"
                                disabled="@(_saving || string.IsNullOrWhiteSpace(_newComment))">
                            @if (_saving)
                            {
                                <span class="loading loading-spinner loading-xs"></span>
                            }
                            Publicar
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-info alert-soft text-sm">
                            <span>
                                <a href="Account/Login" class="link link-primary">Inicia sesión</a>
                                para publicar comentarios.
                            </span>
                        </div>
                    }

                    <div class="divider my-2"></div>

                    @if (_comments.Count == 0)
                    {
                        <p class="text-base-content/50 text-sm">Sin comentarios.</p>
                    }
                    else
                    {
                        <div class="max-h-[60vh] overflow-y-auto pr-1 space-y-1">
                            @foreach (var c in _comments)
                            {
                                var isMine = c.AuthorUserId != null && c.AuthorUserId == _user.UserId;
                                var placement = isMine ? "chat-end" : "chat-start";
                                var bubbleColor = isMine ? "chat-bubble-primary" : "";
                                var initial = string.IsNullOrEmpty(c.Author) ? "?" : c.Author[0].ToString().ToUpper();

                                <div class="chat @placement fade-in-fast">
                                    <div class="chat-image avatar avatar-placeholder">
                                        <div class="bg-neutral text-neutral-content rounded-full w-8">
                                            <span class="text-xs">@initial</span>
                                        </div>
                                    </div>
                                    <div class="chat-header text-xs text-base-content/70">
                                        @c.Author
                                        <time class="text-[10px] opacity-60 ml-1">
                                            @c.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                                        </time>
                                    </div>
                                    <div class="chat-bubble @bubbleColor whitespace-pre-wrap break-words text-sm">
                                        @c.Text
                                    </div>
                                    <div class="chat-footer text-[10px] opacity-60 flex items-center gap-2">
                                        @if (isMine)
                                        {
                                            <span>Publicado</span>
                                        }
                                        @if (CanDelete(c))
                                        {
                                            <button class="link link-hover text-error"
                                                    @onclick="() => DeleteCommentAsync(c)">
                                                Eliminar
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<Toast @ref="_toast" />

@code {
    [Parameter] public int Id { get; set; }

    private Activity? _activity;
    private List<MonthlyStatus> _history = new();
    private List<Comment> _comments = new();
    private bool _loading = true;
    private bool _saving;
    private string _newComment = "";
    private Toast? _toast;

    private CurrentUser _user = CurrentUser.Anonymous;

    protected override async Task OnInitializedAsync()
    {
        _user = await Session.GetCurrentAsync();
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_activity is not null && _activity.Id != Id)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var today = DateTime.Today;
        var activities = await ChecklistSvc.GetActivitiesForMonthAsync(today.Year, today.Month);
        _activity = activities.FirstOrDefault(a => a.Id == Id);

        if (_activity is not null)
        {
            _comments = (await CommentSvc.GetForActivityAsync(Id)).ToList();
            _history = await LoadHistoryAsync(Id);
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task<List<MonthlyStatus>> LoadHistoryAsync(int activityId)
    {
        var result = new List<MonthlyStatus>();
        var cur = DateTime.Today;
        for (int i = 0; i < 12; i++)
        {
            var d = new DateTime(cur.Year, cur.Month, 1).AddMonths(-i);
            var m = await ChecklistSvc.GetOrCreateMonthlyStatusAsync(activityId, d.Year, d.Month);
            result.Add(m);
        }
        return result.OrderByDescending(m => m.Year).ThenByDescending(m => m.Month).ToList();
    }

    private async Task AddCommentAsync()
    {
        if (string.IsNullOrWhiteSpace(_newComment) || _activity is null) return;
        _saving = true;
        try
        {
            var c = await CommentSvc.AddAsync(_activity.Id, _user.DisplayName, _user.UserId, _newComment.Trim());
            _comments.Insert(0, c);
            _newComment = "";
            await _toast!.ShowAsync("Comentario publicado", "success");
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync($"Error: {ex.Message}", "error", 4000);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteCommentAsync(Comment c)
    {
        try
        {
            await CommentSvc.DeleteAsync(c.Id);
            _comments.Remove(c);
            await _toast!.ShowAsync("Comentario eliminado", "success");
        }
        catch (Exception ex)
        {
            await _toast!.ShowAsync($"Error: {ex.Message}", "error", 4000);
        }
    }

    private bool CanDelete(Comment c) =>
        _user.IsAdmin || (c.AuthorUserId != null && c.AuthorUserId == _user.UserId);

    private static string Or(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
